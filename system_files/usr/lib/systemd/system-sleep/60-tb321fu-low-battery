#!/bin/bash
# Lenovo TB321FU: nobody watches the battery while the tablet sleeps on it, so a
# low battery drains to 0% in s2idle, browns out and boot-loops on the charger.
# Before a suspend on battery, arm the PMIC RTC (rtc1: rtc0 is rtc-efi and does
# not wake) for when the charge could be low, assuming 1%/h (s2idle measures
# ~0.4%/h). If that alarm ends the sleep: power off at or below the threshold,
# otherwise suspend again.
set -u

[[ "${2:-}" == suspend ]] || exit 0
tr '\0' '\n' </sys/firmware/devicetree/base/compatible 2>/dev/null |
    grep -qx 'lenovo,tb321fu' || exit 0

rtc=/sys/class/rtc/rtc1
bat=/sys/class/power_supply/battery
state=/run/tb321fu/low-battery-alarm
off_pct=8      # power off at or below this when the alarm wakes us
target_pct=7   # schedule the wake for when 1%/h would reach this

on_external_power() {
    local p
    for p in /sys/class/power_supply/*; do
        [[ "$(cat "$p/type" 2>/dev/null)" == Battery ]] && continue
        [[ "$(cat "$p/online" 2>/dev/null)" == 1 ]] && return 0
    done
    return 1
}

if [[ "$1" == pre ]]; then
    rm -f "$state"
    on_external_power && exit 0
    read -r pct <"$bat/capacity" 2>/dev/null || exit 0
    hours=$(( pct - target_pct ))
    (( hours < 1 )) && hours=1
    secs=$(( hours * 3600 ))
    # The PMIC RTC keeps its own epoch, not the system clock: compare and set
    # the alarm relative to its own time.
    read -r rtc_now <"$rtc/since_epoch" || exit 0
    current=
    read -r current <"$rtc/wakealarm" 2>/dev/null
    # leave an earlier alarm someone else set (rtcwake tests, ...) alone
    [[ -n "$current" && "$current" -lt $(( rtc_now + secs )) ]] && exit 0
    echo 0 >"$rtc/wakealarm" && echo "+$secs" >"$rtc/wakealarm" || exit 0
    mkdir -p "${state%/*}" && echo $(( $(date +%s) + secs )) >"$state"
    exit 0
fi

[[ "$1" == post && -r "$state" ]] || exit 0
read -r when <"$state"
rm -f "$state"
echo 0 >"$rtc/wakealarm" 2>/dev/null

irq=$(cat /sys/power/pm_wakeup_irq 2>/dev/null)
name=
[[ -n "$irq" ]] && name=$(awk -v irq="$irq:" '$1 == irq {print $NF}' /proc/interrupts)
[[ "$name" == *rtc* && $(date +%s) -ge $(( when - 60 )) ]] || exit 0
on_external_power && exit 0

read -r pct <"$bat/capacity" 2>/dev/null || exit 0
if (( pct <= off_pct )); then
    action=poweroff
else
    action=suspend
fi
echo "tb321fu-low-battery: woken by the battery alarm at ${pct}%, ${action}"
# the suspend job is still finishing: queue the next one
systemd-run --quiet --no-block --on-active=15 systemctl "$action"
exit 0
