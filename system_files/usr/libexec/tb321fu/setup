#!/bin/bash
# Install TB321FU-only configuration into /etc (not expressible as card/device
# scoped rules under /usr). Existing files are left alone so users can edit them.
set -u
S=/usr/share/tb321fu/etc

# Older images installed this to keep logind from suspending (fake suspend era).
legacy=/etc/systemd/logind.conf.d/90-tb321fu-power-key.conf
grep -qs "s2idle never resumes" "$legacy" && rm -f "$legacy"

# Files an earlier image installed and the user never changed: drop them so
# the loop below installs the current version.
while read -r sum t; do
    [ -f "$t" ] && echo "$sum  $t" | sha256sum -c --status - && rm -f "$t"
done <<'END'
6b5baeb621b3a5a5796c40100efc2bbfb5ebe583cd2b42a7912302c608e50552  /etc/UPower/UPower.conf.d/70-tb321fu-low-battery.conf
END

cd "$S" || exit 0
find . -type f | while read -r f; do
    t="/etc/${f#./}"
    [ -e "$t" ] && continue
    mkdir -p "$(dirname "$t")"
    cp -a "$f" "$t"
done

# CSOT units: the panel driver has 60 and 120 Hz only (BOE: 60 to 165 Hz). Switch
# the gamescope session file between the two variants as long as the user has
# not edited it (it is still one of the two shipped variants).
sess=/etc/gamescope-session-plus/sessions.d/steam
boe_sess="$S/gamescope-session-plus/sessions.d/steam"
if [ -f "$sess" ] && [ -f "$boe_sess" ]; then
    csot_sess=$(mktemp)
    sed 's/^CUSTOM_REFRESH_RATES=.*/CUSTOM_REFRESH_RATES=60,120/; s/^STEAM_DISPLAY_REFRESH_LIMITS=.*/STEAM_DISPLAY_REFRESH_LIMITS=60,120/' \
        "$boe_sess" > "$csot_sess"
    panel=$(find /sys/firmware/devicetree/base -path '*/panel@0/compatible' -exec cat {} + 2>/dev/null | tr '\0' ' ')
    if [[ "$panel" == *csot* ]]; then want=$csot_sess; else want=$boe_sess; fi
    if ! cmp -s "$want" "$sess" && { cmp -s "$boe_sess" "$sess" || cmp -s "$csot_sess" "$sess"; }; then
        cp "$want" "$sess"
    fi
    rm -f "$csot_sess"
fi

# The install image is smaller than userdata, but the partition already spans the
# rest of the disk: bootc-generic-growpart then reports NOCHANGE and never grows
# the filesystem. Grow btrfs to the partition (a no-op once it fills it).
btrfs filesystem resize max /var >/dev/null 2>&1 || true
