#!/bin/bash
set -euo pipefail

fail() {
    echo "bottom-gamescope: $*" >&2
    exit 1
}

device_env=${ARMADA_DEVICE_ENV:-/usr/libexec/armada/device-env}
gamescope=${ARMADA_GAMESCOPE:-gamescope}
lease_socket=${GAMESCOPE_LEASE_SOCK:-/tmp/gamescope-lease.sock}

eval "$("$device_env")"
orientation=${ARMADA_SECONDARY_PANEL_ORIENTATION:-${ARMADA_PANEL_ORIENTATION:-}}
[[ -n "${ARMADA_SECONDARY_CONNECTOR:-}" ]] || fail "device has no secondary display"
[[ -n "${ARMADA_SECONDARY_TOUCHSCREEN:-}" ]] || fail "device has no secondary touchscreen"
[[ -n "$orientation" ]] || fail "device has no panel orientation"
[[ "${1:-}" != --supported ]] || exit 0
[[ -S "$lease_socket" ]] || fail "DRM lease socket is unavailable: $lease_socket"

extra_args=()
if [[ "${ARMADA_SECONDARY_FORCE_LINEAR:-0}" == 1 ]]; then
    export GAMESCOPE_FORCE_LINEAR_OUTPUT=1
    extra_args+=(--force-composition)
fi

unset DISPLAY WAYLAND_DISPLAY GAMESCOPE_WAYLAND_DISPLAY
export ARMADA_BOTTOM_GAMESCOPE_PID=$$
exec "$gamescope" \
    --backend drm \
    --drm-lease-client "$lease_socket" \
    --drm-lease-yield \
    --expose-wayland \
    --force-windows-fullscreen \
    --xwayland-count 1 \
    --default-touch-mode 4 \
    --force-orientation "$orientation" \
    --force-composition-rotation \
    "${extra_args[@]}" \
    -- /usr/libexec/armada/bottom-gamescope-ready
