# Lenovo TB321FU sensor stack RPMs (libssc, hexagonrpc, iio-sensor-proxy with
# SSC, tb321fu-imu-bridge), built by https://github.com/enij90/tb321fu-sensors.
# The image build fetches the release's SHA256SUMS, checks it against
# TB321FU_SNS_SUMS_SHA256, then checks every RPM against it.
TB321FU_SNS_VERSION=0.1.0
TB321FU_SNS_URL=https://github.com/enij90/tb321fu-sensors/releases/download/v${TB321FU_SNS_VERSION}
TB321FU_SNS_SUMS_SHA256=TODO-after-the-first-release
