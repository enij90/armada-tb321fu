From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] pipewire: report a missing capture buffer once a minute

request_buffer() runs on every vblank while a client streams. A client that
paces the capture (an ambient-light plugin taking 10 small frames a second)
holds the buffers on purpose, so gamescope logged "warning: out of buffers"
up to once per refresh: about 250,000 journal lines in 20 minutes of play on
a 165 Hz panel, and the CPU time to write them. Report the first miss, then
at most once a minute with the count.

diff --git a/src/pipewire.cpp b/src/pipewire.cpp
index 76b3ea8..ef8bc20 100644
--- a/src/pipewire.cpp
+++ b/src/pipewire.cpp
@@ -7,6 +7,7 @@
 #include <unistd.h>
 
 #include <atomic>
+#include <chrono>
 #include <thread>
 #include <vector>
 
@@ -174,7 +175,19 @@ static void request_buffer(struct pipewire_state *state)
 {
 	struct pw_buffer *pw_buffer = pw_stream_dequeue_buffer(state->stream);
 	if (!pw_buffer) {
-		pwr_log.errorf("warning: out of buffers");
+		// A client that paces the capture keeps buffers on purpose, and this
+		// runs on every vblank: report the first miss, then at most once a
+		// minute, instead of a log line per frame.
+		static uint64_t s_ulMissed = 0;
+		static std::chrono::steady_clock::time_point s_LastReport;
+		auto now = std::chrono::steady_clock::now();
+		s_ulMissed++;
+		if (s_ulMissed == 1 || now - s_LastReport >= std::chrono::minutes(1)) {
+			pwr_log.infof("out of buffers: %llu frames without a free buffer since the last report (the client holds them)",
+				(unsigned long long) s_ulMissed);
+			s_ulMissed = 0;
+			s_LastReport = now;
+		}
 		return;
 	}
 
