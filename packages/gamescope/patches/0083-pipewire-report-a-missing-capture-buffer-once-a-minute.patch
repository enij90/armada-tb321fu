From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] pipewire: report a missing capture buffer once a minute

A client that paces the capture (an ambient-light plugin taking 10 small
frames a second) holds the buffers on purpose, so gamescope logged "out of
buffers" on every miss: about 250,000 journal lines in 20 minutes of play on
a 165 Hz panel, and the CPU time to write them. Report the first miss, then
at most once a minute with the count. Rebased on 0035, which moves the
dequeue into the process callback.

diff --git a/src/pipewire.cpp b/src/pipewire.cpp
--- a/src/pipewire.cpp
+++ b/src/pipewire.cpp
@@ -7,6 +7,7 @@
 #include <unistd.h>
 
 #include <atomic>
+#include <chrono>
 #include <thread>
 #include <vector>
 
@@ -174,7 +175,21 @@
 {
 	struct pw_buffer *pw_buffer = pw_stream_dequeue_buffer(state->stream);
 	if (!pw_buffer) {
-		pwr_log.warnf("out of buffers");
+		// A client that paces the capture keeps buffers on purpose: report
+		// the first miss, then at most once a minute, instead of a log line
+		// per process callback.
+		static uint64_t s_ulMissed = 0;
+		static bool s_bReported = false;
+		static std::chrono::steady_clock::time_point s_LastReport;
+		auto now = std::chrono::steady_clock::now();
+		s_ulMissed++;
+		if (!s_bReported || now - s_LastReport >= std::chrono::minutes(1)) {
+			pwr_log.infof("out of buffers: %llu frames without a free buffer since the last report (the client holds them)",
+				(unsigned long long) s_ulMissed);
+			s_ulMissed = 0;
+			s_bReported = true;
+			s_LastReport = now;
+		}
 		return nullptr;
 	}
 	struct pipewire_buffer *buffer = (struct pipewire_buffer *) pw_buffer->user_data;
