From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] input: misc: aw86937-y700: release the reset line and lower the default gain

Some TB321FU units come out of the bootloader with the reset line of the
haptics chip at 0x5a still asserted: the chip does not answer on I2C and
the probe fails reading the chip ID (reported in enij90/armada-tb321fu#9,
GPIO 127 for 0x5a and 119 for 0x5b as in the Android device tree). Take
an optional "reset" GPIO and pulse it before reading the chip ID.

A full-strength effect used gain 0xff. On the TB321FU 0xc0 and 0xff feel
the same (the motor is saturated, it only gets louder) and Android uses
0x80, which also felt nicer in a side by side test. Make 0x80 the
default and add a gain_ceiling module parameter.

---
--- a/drivers/input/misc/aw86937-y700.c
+++ b/drivers/input/misc/aw86937-y700.c
@@ -14,6 +14,7 @@
 #include <linux/delay.h>
 #include <linux/device.h>
 #include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/input.h>
 #include <linux/list.h>
@@ -89,9 +90,17 @@
 #define AW86937_MIN_DURATION_MS			5
 #define AW86937_MAX_DURATION_MS			10000
 #define AW86937_GAIN_CEILING_MAX		0xff
-#define AW86937_GAIN_CEILING_DEFAULT		0xff
+#define AW86937_GAIN_CEILING_DEFAULT		0x80
 #define AW86937_PWM_MODE_DEFAULT		0
 
+/*
+ * Gain of a full-strength effect. On the TB321FU 0xc0 and 0xff feel the same
+ * (the motor is saturated, only louder); 0x80 is what Android uses.
+ */
+static unsigned int gain_ceiling = AW86937_GAIN_CEILING_DEFAULT;
+module_param(gain_ceiling, uint, 0644);
+MODULE_PARM_DESC(gain_ceiling, "Gain of a full-strength effect, 1-255 (default 0x80)");
+
 struct aw86937_y700 {
 	struct device *dev;
 	struct input_dev *input_dev;
@@ -752,7 +761,8 @@
 				    effect->u.rumble.weak_magnitude);
 		}
 		if (level) {
-			gain = level * AW86937_GAIN_CEILING_DEFAULT / 0xffffU;
+			gain = level * clamp(gain_ceiling, 1U,
+					     (unsigned int)AW86937_GAIN_CEILING_MAX) / 0xffffU;
 			if (!gain)
 				gain = 1;
 
@@ -804,6 +814,7 @@
 static int aw86937_y700_probe(struct i2c_client *client)
 {
 	struct aw86937_y700 *haptics;
+	struct gpio_desc *reset;
 	unsigned int hi, lo, playcfg1;
 	int err;
 
@@ -823,6 +834,20 @@
 		return dev_err_probe(&client->dev, PTR_ERR(haptics->regmap),
 				     "failed to allocate regmap\n");
 
+	/*
+	 * Some units come out of the bootloader with the reset line still
+	 * asserted, and then the chip does not answer on I2C: pulse it.
+	 */
+	reset = devm_gpiod_get_optional(&client->dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(reset))
+		return dev_err_probe(&client->dev, PTR_ERR(reset),
+				     "failed to get the reset GPIO\n");
+	if (reset) {
+		usleep_range(1000, 2000);
+		gpiod_set_value_cansleep(reset, 0);
+		usleep_range(8000, 10000);
+	}
+
 	err = regmap_read(haptics->regmap, AW86937_CHIPIDH_REG, &hi);
 	if (err)
 		return dev_err_probe(&client->dev, err,
@@ -882,7 +907,7 @@
 	dev_info(&client->dev,
 		 "AW86937 haptics ready chip_id=0x%04x playcfg1=0x%02x pwm_mode=%u gain_ceiling=0x%02x input=%s\n",
 		 haptics->chip_id, playcfg1, AW86937_PWM_MODE_DEFAULT,
-		 AW86937_GAIN_CEILING_DEFAULT, haptics->input_dev->name);
+		 gain_ceiling, haptics->input_dev->name);
 
 	return 0;
 }
