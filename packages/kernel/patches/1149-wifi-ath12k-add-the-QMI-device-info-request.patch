From c8d5b4abbc9af8fa3e1d4fc8fd530bb3f6353677 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:26 +0000
Subject: [PATCH] wifi: ath12k: add the QMI device info request

A hybrid-bus part is not attached to the APSS: the host learns the
register BAR address and size from the target over QMI once its Q6 is
up, maps it, and programs the static windows. On later bring-ups the
BAR must not move, since the HAL caches doorbell pointers relative to
ab->mem; validate it and only re-arm the windows.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Backport to Armada Linux 7.2.6; retain existing WCN7860 and QDSS support.
Source: https://github.com/RetroidPocket/linux/commit/c8d5b4abbc9af8fa3e1d4fc8fd530bb3f6353677
---
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -1054,6 +1054,12 @@
 	/* UMAC/CE window bases */
 	const struct ath12k_pci_reg_base *reg_base;
 
+	/* WCN7750: windowed access into a BAR reported over QMI */
+	bool hybrid_bus;
+
+	/* keeps ab->mem stable across recovery */
+	u64 hybrid_bar_pa;
+
 	struct napi_struct *napi;
 	struct ath12k_wmi_target_cap_arg target_caps;
 	u32 ext_service_bitmap[WMI_SERVICE_EXT_BM_SIZE];
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -9,6 +9,7 @@
 #include "qmi.h"
 #include "core.h"
 #include "debug.h"
+#include "hif.h"
 #include <linux/of.h>
 #include <linux/firmware.h>
 #include <linux/of_address.h>
@@ -1058,6 +1059,68 @@
 };
 
 static const struct qmi_elem_info qmi_wlanfw_cap_req_msg_v01_ei[] = {
+	{
+		.data_type	= QMI_EOTI,
+		.array_type	= NO_ARRAY,
+		.tlv_type	= QMI_COMMON_TLV_TYPE,
+	},
+};
+
+static const struct qmi_elem_info qmi_wlanfw_device_info_req_msg_v01_ei[] = {
+	{
+		.data_type	= QMI_EOTI,
+		.array_type	= NO_ARRAY,
+		.tlv_type	= QMI_COMMON_TLV_TYPE,
+	},
+};
+
+static const struct qmi_elem_info qmi_wlanfw_device_info_resp_msg_v01_ei[] = {
+	{
+		.data_type	= QMI_STRUCT,
+		.elem_len	= 1,
+		.elem_size	= sizeof(struct qmi_response_type_v01),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x02,
+		.offset		= offsetof(struct qmi_wlanfw_device_info_resp_msg_v01,
+					   resp),
+		.ei_array	= qmi_response_type_v01_ei,
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct qmi_wlanfw_device_info_resp_msg_v01,
+					   bar_addr_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_8_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u64),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x10,
+		.offset		= offsetof(struct qmi_wlanfw_device_info_resp_msg_v01,
+					   bar_addr),
+	},
+	{
+		.data_type	= QMI_OPT_FLAG,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u8),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x11,
+		.offset		= offsetof(struct qmi_wlanfw_device_info_resp_msg_v01,
+					   bar_size_valid),
+	},
+	{
+		.data_type	= QMI_UNSIGNED_4_BYTE,
+		.elem_len	= 1,
+		.elem_size	= sizeof(u32),
+		.array_type	= NO_ARRAY,
+		.tlv_type	= 0x11,
+		.offset		= offsetof(struct qmi_wlanfw_device_info_resp_msg_v01,
+					   bar_size),
+	},
 	{
 		.data_type	= QMI_EOTI,
 		.array_type	= NO_ARRAY,
@@ -2939,6 +3002,101 @@
 	return ret;
 }
 
+/* ath11k_qmi_request_device_info(): the target reports its register BAR
+ * once the Q6 is up.
+ */
+static int ath12k_qmi_request_device_info(struct ath12k_base *ab)
+{
+	struct qmi_wlanfw_device_info_resp_msg_v01 resp = {};
+	struct qmi_wlanfw_device_info_req_msg_v01 req = {};
+	void __iomem *bar_addr_va;
+	struct qmi_txn txn;
+	int ret;
+
+	if (!ab->hybrid_bus)
+		return 0;
+
+	ret = qmi_txn_init(&ab->qmi.handle, &txn,
+			   qmi_wlanfw_device_info_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+
+	ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
+			       QMI_WLANFW_DEVICE_INFO_REQ_V01,
+			       QMI_WLANFW_DEVICE_INFO_REQ_MSG_V01_MAX_LEN,
+			       qmi_wlanfw_device_info_req_msg_v01_ei, &req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		ath12k_warn(ab, "failed to send qmi device info request: %d\n", ret);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn, msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+	if (ret < 0) {
+		ath12k_warn(ab, "failed to wait qmi device info request: %d\n", ret);
+		return ret;
+	}
+
+	if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
+		ath12k_warn(ab, "qmi device info request failed: %d %d\n",
+			    resp.resp.result, resp.resp.error);
+		return -EINVAL;
+	}
+
+	if (!resp.bar_addr_valid || !resp.bar_size_valid) {
+		ath12k_warn(ab, "qmi device info response invalid: %d %d\n",
+			    resp.resp.result, resp.resp.error);
+		return -EINVAL;
+	}
+
+	if (!resp.bar_addr || resp.bar_size != ATH12K_QMI_DEVICE_BAR_SIZE) {
+		ath12k_warn(ab, "qmi device info invalid address and size: %llu %u\n",
+			    resp.bar_addr, resp.bar_size);
+		return -EINVAL;
+	}
+
+	/* ab->mem must not move: the HAL caches doorbell pointers relative to it */
+	if (ab->mem) {
+		if (ab->hybrid_bar_pa != resp.bar_addr ||
+		    ab->mem_len != resp.bar_size) {
+			ath12k_err(ab, "qmi device info bar moved: 0x%llx+0x%lx -> 0x%llx+0x%x\n",
+				   ab->hybrid_bar_pa, ab->mem_len,
+				   resp.bar_addr, resp.bar_size);
+			return -EINVAL;
+		}
+
+		ath12k_dbg(ab, ATH12K_DBG_QMI,
+			   "qmi device info bar addr 0x%llx already mapped\n",
+			   resp.bar_addr);
+
+		/* re-arm on every bring-up */
+		ath12k_hif_cfg_static_window(ab);
+
+		return 0;
+	}
+
+	bar_addr_va = devm_ioremap(ab->dev, resp.bar_addr, resp.bar_size);
+	if (!bar_addr_va) {
+		ath12k_warn(ab, "qmi device info ioremap failed\n");
+		ab->mem_len = 0;
+		return -EIO;
+	}
+
+	ab->mem = bar_addr_va;
+	ab->mem_len = resp.bar_size;
+	ab->hybrid_bar_pa = resp.bar_addr;
+
+	if (!ab->hw_params->ce_remap)
+		ab->mem_ce = ab->mem;
+
+	ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi device info bar addr 0x%llx size 0x%x mapped\n",
+		   resp.bar_addr, resp.bar_size);
+
+	ath12k_hif_cfg_static_window(ab);
+
+	return 0;
+}
+
 /* clang stack usage explodes if this is inlined */
 static noinline_for_stack
 int ath12k_qmi_request_target_cap(struct ath12k_base *ab)
@@ -3955,6 +4113,13 @@
 	ret = ath12k_qmi_request_target_cap(ab);
 	if (ret < 0) {
 		ath12k_warn(ab, "qmi failed to req target capabilities:%d\n", ret);
+		return ret;
+	}
+
+	/* Hybrid bus only: learn where the register BAR lives and map it. */
+	ret = ath12k_qmi_request_device_info(ab);
+	if (ret < 0) {
+		ath12k_warn(ab, "qmi failed to req device info:%d\n", ret);
 		return ret;
 	}
 
diff --git a/drivers/net/wireless/ath/ath12k/qmi.h b/drivers/net/wireless/ath/ath12k/qmi.h
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -389,6 +389,23 @@
 #define QMI_WLANFW_CAP_REQ_V01			0x0024
 #define QMI_WLANFW_CAP_RESP_V01			0x0024
 
+/* The target reports its register BAR once the Q6 is up. */
+#define QMI_WLANFW_DEVICE_INFO_REQ_V01			0x004C
+#define QMI_WLANFW_DEVICE_INFO_REQ_MSG_V01_MAX_LEN	0
+#define ATH12K_QMI_DEVICE_BAR_SIZE			0x200000
+
+struct qmi_wlanfw_device_info_req_msg_v01 {
+	char placeholder;
+};
+
+struct qmi_wlanfw_device_info_resp_msg_v01 {
+	struct qmi_response_type_v01 resp;
+	u64 bar_addr;
+	u32 bar_size;
+	u8 bar_addr_valid;
+	u8 bar_size_valid;
+};
+
 enum qmi_wlanfw_pipedir_enum_v01 {
 	QMI_WLFW_PIPEDIR_NONE_V01 = 0,
 	QMI_WLFW_PIPEDIR_IN_V01 = 1,
