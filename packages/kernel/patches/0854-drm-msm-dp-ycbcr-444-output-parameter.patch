 MODULE_PARM_DESC(dp_vsc_force, "Send the BT.2020 VSC SDP even if the sink does not advertise VSC (default off)");
 
+/*
+ * YCbCr 4:4:4 output (testing). Some DP-to-HDMI converters only switch the
+ * monitor to HDR when the source sends YCbCr. 1: when the connector asks for
+ * BT.2020 (HDR), 2: always. The CDM converts the pipe output, MISC0 (and the
+ * VSC SDP when it can be sent) signal it.
+ */
+static int dp_ycbcr;
+module_param(dp_ycbcr, int, 0644);
+MODULE_PARM_DESC(dp_ycbcr, "YCbCr 4:4:4 on DisplayPort (testing): 0 off, 1 with HDR (BT.2020), 2 always");
+
+/* Also set the YUV bit of DP_CONFIGURATION_CTRL with YCbCr 4:4:4 (testing) */
+static bool dp_ycbcr_yuv_bit;
+module_param(dp_ycbcr_yuv_bit, bool, 0644);
+MODULE_PARM_DESC(dp_ycbcr_yuv_bit, "Set the YUV bit of CONFIGURATION_CTRL for YCbCr 4:4:4 (testing)");
+
+int msm_dp_panel_ycbcr_param(void)
+{
+	return dp_ycbcr;
+}
+
+bool msm_dp_panel_ycbcr_yuv_bit(void)
+{
+	return dp_ycbcr_yuv_bit;
+}
