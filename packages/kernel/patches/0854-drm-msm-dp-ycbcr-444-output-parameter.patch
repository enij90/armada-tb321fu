--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1459,6 +1459,26 @@
 	return 0;
 }
 
+/*
+ * YCbCr 4:4:4 instead of RGB (msm.dp_ycbcr, testing). Asked by the DPU at
+ * atomic_check (CDM in the topology) and at enable (CDM setup), and by the
+ * bridge at enable (MISC0, VSC).
+ */
+bool msm_dp_ycbcr444(struct msm_dp *dp, const struct drm_connector_state *conn_state,
+		     const struct drm_display_mode *mode)
+{
+	int param = msm_dp_panel_ycbcr_param();
+
+	if (!dp || dp->is_edp || !dp->connector || !conn_state || !mode || param <= 0)
+		return false;
+	if (drm_mode_is_420_only(&dp->connector->display_info, mode))
+		return false;
+	if (msm_dp_mode_uses_dsc(dp, mode))
+		return false;
+
+	return param >= 2 || conn_state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB;
+}
+
 /* HDR metadata and colorimetry of the connector, for msm_dp_panel_timing_cfg() */
 static void msm_dp_display_set_hdr(struct msm_dp_display_private *dp,
 				   struct drm_bridge *bridge,
@@ -1470,6 +1490,7 @@
 
 	panel->hdr_enabled = false;
 	panel->bt2020 = false;
+	panel->ycbcr444 = false;
 	if (dp->msm_dp_display.is_edp)
 		return;
 
@@ -1481,6 +1502,11 @@
 		return;
 
 	panel->bt2020 = conn_state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB;
+	panel->ycbcr444 = msm_dp_ycbcr444(&dp->msm_dp_display, conn_state,
+					  &dp->msm_dp_mode.drm_mode);
+	if (panel->ycbcr444)
+		drm_info(dp->drm_dev, "DP: YCbCr 4:4:4 out (%s)\n",
+			 panel->bt2020 ? "BT.2020" : "BT.709");
 	if (!msm_dp_utils_pack_hdr_sdp(conn_state, &panel->hdr_sdp))
 		panel->hdr_enabled = !!conn_state->hdr_output_metadata;
 
