From 7d9b6f2688952f71b4125cdb2974054330823609 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:21 +0000
Subject: [PATCH] wifi: ath12k: take the shadow register base from hw_params

The shadow register block is at 0x8fc on the PCIe parts but at 0x504
on the WPSS-hosted WCN parts, the same split ath11k carries between
wcn6855_regs and wcn6750_regs. Writing doorbells at the wrong offset
lands in an unrelated register block. Make the base a hw_params field.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Backport to Armada Linux 7.2.6; retain existing WCN7860 and QDSS support.
Source: https://github.com/RetroidPocket/linux/commit/7d9b6f2688952f71b4125cdb2974054330823609
---
diff --git a/drivers/net/wireless/ath/ath12k/hw.h b/drivers/net/wireless/ath/ath12k/hw.h
--- a/drivers/net/wireless/ath/ath12k/hw.h
+++ b/drivers/net/wireless/ath/ath12k/hw.h
@@ -198,6 +198,9 @@
 	bool supports_aspm:1;
 	bool current_cc_support:1;
 
+	/* 0x8fc on PCIe parts, 0x504 on WPSS-hosted WCN parts */
+	u32 hal_shadow_base_addr;
+
 	u32 num_tcl_banks;
 	u32 max_tx_ring;
 
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hal.c b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
@@ -398,10 +398,10 @@
 	srng = &hal->srng_list[ring_id];
 
 	if (srng_config->ring_dir == HAL_SRNG_DIR_DST)
-		srng->u.dst_ring.tp_addr = (u32 *)(HAL_SHADOW_REG(shadow_cfg_idx) +
+		srng->u.dst_ring.tp_addr = (u32 *)(HAL_SHADOW_REG(ab, shadow_cfg_idx) +
 						   (unsigned long)ab->mem);
 	else
-		srng->u.src_ring.hp_addr = (u32 *)(HAL_SHADOW_REG(shadow_cfg_idx) +
+		srng->u.src_ring.hp_addr = (u32 *)(HAL_SHADOW_REG(ab, shadow_cfg_idx) +
 						   (unsigned long)ab->mem);
 }
 
@@ -450,7 +450,7 @@
 	ath12k_dbg(ab, ATH12K_DBG_HAL,
 		   "target_reg %x, shadow reg 0x%x shadow_idx 0x%x, ring_type %d, ring num %d",
 		  target_reg,
-		  HAL_SHADOW_REG(shadow_cfg_idx),
+		  HAL_SHADOW_REG(ab, shadow_cfg_idx),
 		  shadow_cfg_idx,
 		  ring_type, ring_num);
 
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hal.h b/drivers/net/wireless/ath/ath12k/wifi7/hal.h
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.h
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.h
@@ -16,11 +16,13 @@
 
 /* calculate the register address from bar0 of shadow register x */
 #define HAL_SHADOW_BASE_ADDR			0x000008fc
+#define HAL_SHADOW_BASE_ADDR_WCN7750		0x00000504
 #define HAL_SHADOW_NUM_REGS			40
 #define HAL_HP_OFFSET_IN_REG_START		1
 #define HAL_OFFSET_FROM_HP_TO_TP		4
 
-#define HAL_SHADOW_REG(x) (HAL_SHADOW_BASE_ADDR + (4 * (x)))
+#define HAL_SHADOW_REG(ab, x) \
+	((ab)->hw_params->hal_shadow_base_addr + (4 * (x)))
 #define HAL_REO_QDESC_MAX_PEERID		8191
 
 /* WCSS Relative address */
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hw.c b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
--- a/drivers/net/wireless/ath/ath12k/wifi7/hw.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
@@ -492,6 +492,7 @@
 		.tcl_ring_retry = false,
 		.reoq_lut_support = false,
 		.supports_shadow_regs = true,
+		.hal_shadow_base_addr = HAL_SHADOW_BASE_ADDR,
 
 		.num_tcl_banks = 7,
 		.max_tx_ring = 3,
@@ -756,6 +757,7 @@
 		.tcl_ring_retry = false,
 		.reoq_lut_support = false,
 		.supports_shadow_regs = true,
+		.hal_shadow_base_addr = HAL_SHADOW_BASE_ADDR,
 
 		.num_tcl_banks = 7,
 		.max_tx_ring = 3,
