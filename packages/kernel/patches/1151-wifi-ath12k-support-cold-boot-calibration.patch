From 2f10dd06904a0af0897bdaa00dcb2e17cffe6b0d Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:28 +0000
Subject: [PATCH] wifi: ath12k: support cold boot calibration

The firmware boots uncalibrated unless a calibration pass is requested
first. Request QMI_WLFW_CALIBRATION after BDF/M3/QDSS and before
wlan_cfg, wait for CAL_DONE, and treat the FW_READY of the calibration
instance as the cue to power cycle the firmware rather than as a
mission-mode bring-up. Done once per driver load.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Backport to Armada Linux 7.2.6; retain existing WCN7860 and QDSS support. Use 7.2 QMI constants and reuse Armada 0040 for QDSS download.
Source: https://github.com/RetroidPocket/linux/commit/2f10dd06904a0af0897bdaa00dcb2e17cffe6b0d
---
diff --git a/drivers/net/wireless/ath/ath12k/ahb.c b/drivers/net/wireless/ath/ath12k/ahb.c
--- a/drivers/net/wireless/ath/ath12k/ahb.c
+++ b/drivers/net/wireless/ath/ath12k/ahb.c
@@ -1154,6 +1154,7 @@
 	set_bit(ATH12K_FLAG_UNREGISTERING, &ab->dev_flags);
 	cancel_work_sync(&ab->restart_work);
 	cancel_work_sync(&ab->qmi.event_work);
+	ath12k_core_stop_cal_restart(ab);
 }
 
 static void ath12k_ahb_free_resources(struct ath12k_base *ab)
@@ -1175,6 +1176,8 @@
 	struct ath12k_base *ab = platform_get_drvdata(pdev);
 
 	if (test_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags)) {
+		ath12k_core_stop_cal_restart(ab);
+
 		ath12k_ahb_power_down(ab, false);
 		goto qmi_fail;
 	}
diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -11,6 +11,7 @@
 #include <linux/firmware.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
+#include <linux/delay.h>
 #include "ahb.h"
 #include "core.h"
 #include "dp_tx.h"
@@ -787,6 +788,36 @@
 	return 0;
 }
 
+/* QMI server go-away/come-back around the power cycle */
+#define ATH12K_CAL_RESTART_SETTLE_MS	100
+
+/* The host restarts the firmware after cold boot calibration. */
+static void ath12k_core_cal_restart_work(struct work_struct *work)
+{
+	struct ath12k_base *ab = container_of(work, struct ath12k_base,
+					      cal_restart_work);
+	int ret;
+
+	ath12k_dbg(ab, ATH12K_DBG_BOOT,
+		   "restarting firmware after cold boot calibration\n");
+
+	ath12k_hif_power_down(ab, false);
+
+	msleep(ATH12K_CAL_RESTART_SETTLE_MS);
+
+	ret = ath12k_hif_power_up(ab);
+	if (ret)
+		ath12k_err(ab, "failed to power up after calibration: %d\n", ret);
+}
+
+/* Not to be left in flight across teardown. */
+void ath12k_core_stop_cal_restart(struct ath12k_base *ab)
+{
+	ab->cal_restart_pending = false;
+	cancel_work_sync(&ab->cal_restart_work);
+}
+EXPORT_SYMBOL(ath12k_core_stop_cal_restart);
+
 static int ath12k_core_soc_create(struct ath12k_base *ab)
 {
 	int ret;
@@ -801,6 +832,8 @@
 		ath12k_err(ab, "failed to initialize qmi :%d\n", ret);
 		return ret;
 	}
+
+	INIT_WORK(&ab->cal_restart_work, ath12k_core_cal_restart_work);
 
 	ath12k_debugfs_soc_create(ab);
 
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -61,6 +61,8 @@
 
 #define ATH12K_MON_TIMER_INTERVAL  10
 #define ATH12K_RESET_TIMEOUT_HZ			(20 * HZ)
+/* Downstream allows ICNSS_CAL_TIMEOUT for a cold boot calibration pass. */
+#define ATH12K_COLDBOOT_CAL_TIMEOUT		(40 * HZ)
 #define ATH12K_RESET_MAX_FAIL_COUNT_FIRST	3
 #define ATH12K_RESET_MAX_FAIL_COUNT_FINAL	5
 #define ATH12K_RESET_FAIL_TIMEOUT_HZ		(20 * HZ)
@@ -1106,6 +1108,13 @@
 	/* continuous recovery fail count */
 	atomic_t fail_cont_count;
 	unsigned long reset_fail_timeout;
+
+	struct completion cal_done;
+	bool cal_done_seen;
+
+	/* FW_READY from the calibration instance triggers a restart instead */
+	bool cal_restart_pending;
+	struct work_struct cal_restart_work;
 	struct work_struct update_11d_work;
 	u8 new_alpha2[2];
 	struct {
@@ -1303,6 +1312,7 @@
 int ath12k_core_pre_init(struct ath12k_base *ab);
 int ath12k_core_init(struct ath12k_base *ath12k);
 void ath12k_core_deinit(struct ath12k_base *ath12k);
+void ath12k_core_stop_cal_restart(struct ath12k_base *ab);
 struct ath12k_base *ath12k_core_alloc(struct device *dev, size_t priv_size,
 				      enum ath12k_bus bus);
 void ath12k_core_free(struct ath12k_base *ath12k);
diff --git a/drivers/net/wireless/ath/ath12k/hw.h b/drivers/net/wireless/ath/ath12k/hw.h
--- a/drivers/net/wireless/ath/ath12k/hw.h
+++ b/drivers/net/wireless/ath/ath12k/hw.h
@@ -195,6 +195,7 @@
 	bool tcl_ring_retry:1;
 	bool reoq_lut_support:1;
 	bool supports_shadow_regs:1;
+	bool supports_coldboot_cal:1;
 	bool supports_aspm:1;
 	bool current_cc_support:1;
 
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -4246,6 +4246,44 @@
 		}		
 	}
 
+	/* After target cap/BDF/M3/QDSS, before wlan_ini/wlan_cfg
+	 * (QMI_ERR_INCOMPATIBLE_STATE_V01). Once per driver load.
+	 */
+	if (ab->hw_params->supports_coldboot_cal && !ab->cal_done_seen) {
+		unsigned long left;
+
+		ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi requesting cold boot calibration\n");
+		reinit_completion(&ab->cal_done);
+
+		ret = ath12k_qmi_wlanfw_mode_send(ab,
+						  ATH12K_FIRMWARE_MODE_CALIBRATION);
+		if (ret < 0) {
+			ath12k_warn(ab, "qmi failed to request calibration: %d\n",
+				    ret);
+			return 0;
+		}
+
+		left = wait_for_completion_timeout(&ab->cal_done,
+						   ATH12K_COLDBOOT_CAL_TIMEOUT);
+
+		/* target still in calibration mode; let recovery bring it up fresh */
+		if (!left || !ab->cal_done_seen) {
+			ath12k_warn(ab, "qmi cold boot calibration %s\n",
+				    left ? "aborted" : "timed out");
+			return -ECANCELED;
+		}
+
+		ath12k_dbg(ab, ATH12K_DBG_QMI,
+			   "qmi cold boot calibration finished after %ums, waiting for firmware restart\n",
+			    jiffies_to_msecs(ATH12K_COLDBOOT_CAL_TIMEOUT - left));
+
+		/* The firmware restarts itself; FW_READY from this instance is not a
+		 * bring-up (ath11k).
+		 */
+		ab->cal_restart_pending = true;
+		return 0;
+	}
+
 	return ret;
 }
 
@@ -4318,7 +4356,27 @@
 	ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_FW_READY, NULL);
 }
 
+static void ath12k_qmi_msg_cal_done_cb(struct qmi_handle *qmi_hdl,
+				       struct sockaddr_qrtr *sq,
+				       struct qmi_txn *txn,
+				       const void *data)
+{
+	struct ath12k_qmi *qmi = container_of(qmi_hdl, struct ath12k_qmi, handle);
+	struct ath12k_base *ab = qmi->ab;
+
+	ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi cold boot calibration done\n");
+	ab->cal_done_seen = true;
+	complete(&ab->cal_done);
+}
 static const struct qmi_msg_handler ath12k_qmi_msg_handlers[] = {
+	{
+		.type = QMI_INDICATION,
+		.msg_id = QMI_WLFW_CAL_DONE_IND_V01,
+		.ei = qmi_wlanfw_fw_ready_ind_msg_v01_ei,
+		.decoded_size = sizeof(struct qmi_wlanfw_fw_ready_ind_msg_v01),
+		.fn = ath12k_qmi_msg_cal_done_cb,
+	},
+
 	{
 		.type = QMI_INDICATION,
 		.msg_id = QMI_WLFW_REQUEST_MEM_IND_V01,
@@ -4405,6 +4463,7 @@
 			return ret;
 		}
 	}
+
 
 	return ret;
 }
@@ -4448,6 +4507,15 @@
 			break;
 		case ATH12K_QMI_EVENT_FW_READY:
 			clear_bit(ATH12K_FLAG_QMI_FAIL, &ab->dev_flags);
+
+			if (ab->cal_restart_pending) {
+				ath12k_dbg(ab, ATH12K_DBG_QMI,
+					   "qmi fw ready from the calibration instance, restarting\n");
+				ab->cal_restart_pending = false;
+				queue_work(ab->workqueue, &ab->cal_restart_work);
+				break;
+			}
+
 			if (test_bit(ATH12K_FLAG_QMI_FW_READY_COMPLETE, &ab->dev_flags)) {
 				if (ab->is_reset)
 					ath12k_hal_dump_srng_stats(ab);
@@ -4486,6 +4554,8 @@
 {
 	int ret;
 
+	init_completion(&ab->cal_done);
+
 	memset(&ab->qmi.target, 0, sizeof(struct target_info));
 	memset(&ab->qmi.target_mem, 0, sizeof(struct target_mem_chunk));
 	ab->qmi.ab = ab;
diff --git a/drivers/net/wireless/ath/ath12k/qmi.h b/drivers/net/wireless/ath/ath12k/qmi.h
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -35,6 +35,8 @@
 #define QMI_WLFW_FW_READY_IND_V01		0x0038
 
 #define QMI_WLANFW_MAX_DATA_SIZE_V01		6144
+#define QMI_WLFW_CAL_DONE_IND_V01		0x003E
+#define ATH12K_FIRMWARE_MODE_CALIBRATION	7
 #define ATH12K_FIRMWARE_MODE_OFF		4
 
 #define ATH12K_BOARD_ID_DEFAULT	0xFF
