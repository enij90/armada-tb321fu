From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] iio: light: add the TB321FU ambient light sensor, fed from userspace

The TB321FU light sensor is a Qualcomm Sensor Core sensor on the ADSP,
reached from Linux only through libssc. Steam's adaptive brightness and
iio-sensor-proxy read light from IIO sysfs, so add an IIO light device
that tb321fu-als-bridge feeds: root writes lux to in_illuminance_input,
readers get input, or raw with a scale of 1. The device is created only
on lenovo,tb321fu and named "als", one of the three names Steam accepts
(with ltrf216a and opt3001, the Steam Deck sensors).

diff -uNr a/drivers/iio/light/Kconfig b/drivers/iio/light/Kconfig
--- a/drivers/iio/light/Kconfig	2026-10-11 13:49:38.727566996 +0200
+++ b/drivers/iio/light/Kconfig	2026-10-11 13:49:38.745980056 +0200
@@ -597,6 +597,18 @@
 	depends on ST_UVIS25
 	select REGMAP_SPI
 
+config TB321FU_ALS
+	tristate "Lenovo TB321FU ambient light sensor fed from userspace"
+	depends on OF || COMPILE_TEST
+	help
+	  The Lenovo Legion Tab Gen 3 (TB321FU) light sensor sits behind the
+	  Qualcomm Sensor Core on the ADSP. Say Y here to get an IIO light
+	  device that a userspace daemon (tb321fu-als-bridge) feeds with the
+	  sensor's readings, for Steam and iio-sensor-proxy.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called tb321fu-als.
+
 config TCS3414
 	tristate "TAOS TCS3414 digital color sensor"
 	depends on I2C
diff -uNr a/drivers/iio/light/Makefile b/drivers/iio/light/Makefile
--- a/drivers/iio/light/Makefile	2026-10-11 13:49:38.727699614 +0200
+++ b/drivers/iio/light/Makefile	2026-10-11 13:49:38.746106464 +0200
@@ -55,6 +55,7 @@
 obj-$(CONFIG_ST_UVIS25)		+= st_uvis25_core.o
 obj-$(CONFIG_ST_UVIS25_I2C)	+= st_uvis25_i2c.o
 obj-$(CONFIG_ST_UVIS25_SPI)	+= st_uvis25_spi.o
+obj-$(CONFIG_TB321FU_ALS)	+= tb321fu-als.o
 obj-$(CONFIG_TCS3414)		+= tcs3414.o
 obj-$(CONFIG_TCS3472)		+= tcs3472.o
 obj-$(CONFIG_SENSORS_TSL2563)	+= tsl2563.o
diff -uNr a/drivers/iio/light/tb321fu-als.c b/drivers/iio/light/tb321fu-als.c
--- a/drivers/iio/light/tb321fu-als.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/iio/light/tb321fu-als.c	2026-10-11 13:49:38.729721256 +0200
@@ -0,0 +1,138 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Lenovo TB321FU ambient light sensor, fed from userspace.
+ *
+ * The light sensor sits behind the Qualcomm Sensor Core on the ADSP, which
+ * Linux reaches only through libssc. Steam and iio-sensor-proxy look for an
+ * IIO light device in sysfs, so this driver provides one: a root daemon
+ * (tb321fu-als-bridge) writes each SSC reading, in lux, to
+ * in_illuminance_input, and readers get it back as input or as raw * scale.
+ */
+
+#include <linux/atomic.h>
+#include <linux/iio/iio.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#define TB321FU_ALS_MAX_MLUX	(200000 * 1000)	/* 200 klux */
+
+struct tb321fu_als {
+	atomic_t mlux;
+};
+
+static const struct iio_chan_spec tb321fu_als_channels[] = {
+	{
+		.type = IIO_LIGHT,
+		.info_mask_separate = BIT(IIO_CHAN_INFO_PROCESSED) |
+				      BIT(IIO_CHAN_INFO_RAW) |
+				      BIT(IIO_CHAN_INFO_SCALE),
+	},
+};
+
+static int tb321fu_als_read_raw(struct iio_dev *indio_dev,
+				struct iio_chan_spec const *chan,
+				int *val, int *val2, long mask)
+{
+	struct tb321fu_als *als = iio_priv(indio_dev);
+	int mlux = atomic_read(&als->mlux);
+
+	switch (mask) {
+	case IIO_CHAN_INFO_PROCESSED:
+		*val = mlux / 1000;
+		*val2 = (mlux % 1000) * 1000;
+		return IIO_VAL_INT_PLUS_MICRO;
+	case IIO_CHAN_INFO_RAW:
+		*val = mlux / 1000;
+		return IIO_VAL_INT;
+	case IIO_CHAN_INFO_SCALE:
+		*val = 1;
+		return IIO_VAL_INT;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int tb321fu_als_write_raw(struct iio_dev *indio_dev,
+				 struct iio_chan_spec const *chan,
+				 int val, int val2, long mask)
+{
+	struct tb321fu_als *als = iio_priv(indio_dev);
+	s64 mlux;
+
+	if (mask != IIO_CHAN_INFO_PROCESSED || val < 0 || val2 < 0)
+		return -EINVAL;
+
+	mlux = (s64)val * 1000 + val2 / 1000;
+	atomic_set(&als->mlux, min_t(s64, mlux, TB321FU_ALS_MAX_MLUX));
+	return 0;
+}
+
+static const struct iio_info tb321fu_als_info = {
+	.read_raw = tb321fu_als_read_raw,
+	.write_raw = tb321fu_als_write_raw,
+};
+
+static int tb321fu_als_probe(struct platform_device *pdev)
+{
+	struct iio_dev *indio_dev;
+	struct tb321fu_als *als;
+
+	indio_dev = devm_iio_device_alloc(&pdev->dev, sizeof(*als));
+	if (!indio_dev)
+		return -ENOMEM;
+
+	als = iio_priv(indio_dev);
+	atomic_set(&als->mlux, 0);
+
+	/* Steam takes light sensors named ltrf216a, opt3001 or als only. */
+	indio_dev->name = "als";
+	indio_dev->info = &tb321fu_als_info;
+	indio_dev->modes = INDIO_DIRECT_MODE;
+	indio_dev->channels = tb321fu_als_channels;
+	indio_dev->num_channels = ARRAY_SIZE(tb321fu_als_channels);
+
+	return devm_iio_device_register(&pdev->dev, indio_dev);
+}
+
+static struct platform_driver tb321fu_als_driver = {
+	.driver = {
+		.name = "tb321fu-als",
+	},
+	.probe = tb321fu_als_probe,
+};
+
+static struct platform_device *tb321fu_als_pdev;
+
+static int __init tb321fu_als_init(void)
+{
+	int ret;
+
+	if (!of_machine_is_compatible("lenovo,tb321fu"))
+		return -ENODEV;
+
+	ret = platform_driver_register(&tb321fu_als_driver);
+	if (ret)
+		return ret;
+
+	tb321fu_als_pdev = platform_device_register_simple("tb321fu-als",
+							   PLATFORM_DEVID_NONE,
+							   NULL, 0);
+	if (IS_ERR(tb321fu_als_pdev)) {
+		platform_driver_unregister(&tb321fu_als_driver);
+		return PTR_ERR(tb321fu_als_pdev);
+	}
+
+	return 0;
+}
+module_init(tb321fu_als_init);
+
+static void __exit tb321fu_als_exit(void)
+{
+	platform_device_unregister(tb321fu_als_pdev);
+	platform_driver_unregister(&tb321fu_als_driver);
+}
+module_exit(tb321fu_als_exit);
+
+MODULE_DESCRIPTION("Lenovo TB321FU ambient light sensor fed from userspace");
+MODULE_LICENSE("GPL");
