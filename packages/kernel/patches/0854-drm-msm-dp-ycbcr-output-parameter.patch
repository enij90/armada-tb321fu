 		if (fb && MSM_FORMAT_IS_YUV(msm_framebuffer_format(fb)))
 			topology->num_cdm++;
 	} else if (disp_info->intf_type == INTF_DP) {
-		if (drm_mode_is_420_only(&connector->display_info, adj_mode))
+		struct msm_drm_private *priv = drm_enc->dev->dev_private;
+
+		if (drm_mode_is_420_only(&connector->display_info, adj_mode) ||
+		    msm_dp_ycbcr444(priv->kms->dp[disp_info->h_tile_instance[0]],
+				    conn_state, adj_mode))
 			topology->num_cdm++;
 	}
 }
@@ -2555,6 +2589,13 @@
 	cdm_cfg->output_bit_depth = MSM_FORMAT_IS_DX(dpu_fmt) ?
 			CDM_CDWN_OUTPUT_10BIT : CDM_CDWN_OUTPUT_8BIT;
 	cdm_cfg->csc_cfg = &dpu_csc10_rgb2yuv_601l;
+	if (dpu_fmt == &dpu_dp_ycbcr444_fmt || dpu_fmt == &dpu_dp_ycbcr422_fmt) {
+		struct dpu_encoder_virt *dpu_enc = to_dpu_encoder_virt(phys_enc->parent);
+		bool bt2020 = dpu_enc->connector && dpu_enc->connector->state &&
+			dpu_enc->connector->state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB;
+
+		cdm_cfg->csc_cfg = bt2020 ? &dpu_csc10_rgb2yuv_2020l : &dpu_csc10_rgb2yuv_709l;
+	}
 
 	/* enable 10 bit logic */
 	switch (cdm_cfg->output_fmt->chroma_sample) {
