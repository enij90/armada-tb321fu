+/*
+ * YCbCr 4:4:4 instead of RGB (msm.dp_ycbcr, testing). Asked by the DPU at
+ * atomic_check (CDM in the topology) and at enable (CDM setup), and by the
+ * bridge at enable (MISC0, VSC).
+ */
+bool msm_dp_ycbcr444(struct msm_dp *dp, const struct drm_connector_state *conn_state,
+		     const struct drm_display_mode *mode)
+{
+	int param = msm_dp_panel_ycbcr_param();
+
+	if (!dp || dp->is_edp || !dp->connector || !conn_state || !mode || param <= 0)
+		return false;
+	if (drm_mode_is_420_only(&dp->connector->display_info, mode))
+		return false;
+	if (msm_dp_mode_uses_dsc(dp, mode))
+		return false;
+
+	return param == 2 || param >= 4 ||
+	       conn_state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB;
+}
+
+/* With msm_dp_ycbcr444() true: 4:2:2 instead of 4:4:4 */
+bool msm_dp_ycbcr422(void)
+{
+	return msm_dp_panel_ycbcr_param() >= 3;
+}
