From f23d44355701c909ab63a3253644af114eb0427c Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:29 +0000
Subject: [PATCH] wifi: ath12k: track the firmware generation across recovery

On a transport whose firmware restarts itself the target can be swapped
out under a bring-up that is still in progress. Count QMI server exits;
a bring-up that finds the generation changed must not stop the fresh
instance, and a failed crash recovery must keep the HAL so the next
FW_READY can retry through ath12k_ce_init_pipes().

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Backport to Armada Linux 7.2.6; retain existing WCN7860 and QDSS support.
Source: https://github.com/RetroidPocket/linux/commit/f23d44355701c909ab63a3253644af114eb0427c
---
diff --git a/drivers/net/wireless/ath/ath12k/core.c b/drivers/net/wireless/ath/ath12k/core.c
--- a/drivers/net/wireless/ath/ath12k/core.c
+++ b/drivers/net/wireless/ath/ath12k/core.c
@@ -1319,7 +1319,15 @@
 int ath12k_core_qmi_firmware_ready(struct ath12k_base *ab)
 {
 	struct ath12k_hw_group *ag = ath12k_ab_to_ag(ab);
-	int ret, i;
+	int ret, i, gen;
+
+	/* firmware instance this bring-up belongs to */
+	gen = atomic_read(&ab->fw_generation);
+
+	if (!ab->hal.srng_config) {
+		ath12k_err(ab, "hal is not initialised, refusing firmware bring-up\n");
+		return -EINVAL;
+	}
 
 	ret = ath12k_core_start_firmware(ab, ab->fw_mode);
 	if (ret) {
@@ -1384,7 +1392,12 @@
 	mutex_unlock(&ag->mutex);
 
 err_firmware_stop:
-	ath12k_qmi_firmware_stop(ab);
+	/* A crash mid bring-up swapped the target; do not stop the new instance. */
+	if (atomic_read(&ab->fw_generation) != gen)
+		ath12k_warn(ab, "firmware restarted during bring-up (gen %d -> %d), not stopping the new instance\n",
+			    gen, atomic_read(&ab->fw_generation));
+	else
+		ath12k_qmi_firmware_stop(ab);
 
 exit:
 	return ret;
@@ -1415,16 +1428,18 @@
 	clear_bit(ATH12K_FLAG_CRASH_FLUSH, &ab->dev_flags);
 
 	ret = ath12k_core_qmi_firmware_ready(ab);
-	if (ret)
-		goto err_hal_srng_deinit;
+	if (ret) {
+		/* Keep the HAL: the next FW_READY retries through ath12k_ce_init_pipes(),
+		 * which needs it.
+		 */
+		ath12k_warn(ab, "crash recovery failed, keeping hal for retry: %d\n",
+			    ret);
+		return ret;
+	}
 
 	clear_bit(ATH12K_FLAG_RECOVERY, &ab->dev_flags);
 
 	return 0;
-
-err_hal_srng_deinit:
-	ath12k_hal_srng_deinit(ab);
-	return ret;
 }
 
 static void ath12k_rfkill_work(struct work_struct *work)
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -1109,6 +1109,9 @@
 	atomic_t fail_cont_count;
 	unsigned long reset_fail_timeout;
 
+	/* bumped when the QMI server goes away */
+	atomic_t fw_generation;
+
 	struct completion cal_done;
 	bool cal_done_seen;
 
diff --git a/drivers/net/wireless/ath/ath12k/qmi.c b/drivers/net/wireless/ath/ath12k/qmi.c
--- a/drivers/net/wireless/ath/ath12k/qmi.c
+++ b/drivers/net/wireless/ath/ath12k/qmi.c
@@ -4435,6 +4435,10 @@
 	struct ath12k_base *ab = qmi->ab;
 
 	ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi wifi fw del server\n");
+
+	/* in-flight bring-ups must not complete against the replacement */
+	atomic_inc(&ab->fw_generation);
+
 	ath12k_qmi_driver_event_post(qmi, ATH12K_QMI_EVENT_SERVER_EXIT, NULL);
 }
 
