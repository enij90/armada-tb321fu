+		aw_dev->ops.aw_i2c_write_bits(aw_dev, mute_desc->reg,
+				mute_desc->mask,
+				mute_desc->enable);
+		usleep_range(AW_5000_US, AW_5000_US + 50);
+	} else {
+		aw_dev->ops.aw_i2c_write_bits(aw_dev, mute_desc->reg,
+				mute_desc->mask,
+				mute_desc->disable);
+		aw_dev_fade_in(aw_dev);
+	}
+	aw_dev_info(aw_dev->dev, "done");
+}
