+	vol_desc->ctl_volume = value;
+	compared_vol = AW_GET_MAX_VALUE(vol_desc->ctl_volume,
+						vol_desc->monitor_volume);
+
+	aw882xx_dev_set_volume(aw882xx->aw_pa, compared_vol);
