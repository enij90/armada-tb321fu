+	snprintf(buf, sizeof(buf), format, *name, channel);
+	(*name) = aw882xx_devm_kstrdup(aw882xx->dev, buf);
+	if (!(*name))
+		return -ENOMEM;
+
+	aw_dev_info(aw882xx->dev, "change name is %s", (*name));
