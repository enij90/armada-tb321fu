+int aw882xx_get_version(char *buf, int size)
+{
+	if (size > strlen(AW882XX_DRIVER_VERSION)) {
+		memcpy(buf, AW882XX_DRIVER_VERSION, strlen(AW882XX_DRIVER_VERSION));
+		return strlen(AW882XX_DRIVER_VERSION);
+	} else {
+		return -ENOMEM;
+	}
+}
