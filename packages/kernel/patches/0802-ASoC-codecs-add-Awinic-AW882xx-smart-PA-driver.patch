+	ret = aw_cali_svc_devs_get_cali_cali_data(dev_list, CALI_DATA_RE);
+exit:
+	aw_cali_svc_devs_cali_mode_enable(dev_list, CALI_TYPE_RE, flag, false);
+	return ret;
