+static void *aw882xx_devm_kstrdup(struct device *dev, char *buf)
+{
+	char *str = NULL;
+
+	str = devm_kzalloc(dev, strlen(buf) + 1, GFP_KERNEL);
+	if (!str)
+		return str;
+
+	memcpy(str, buf, strlen(buf));
+	return str;
+}
