From aaa9c19f21f7c651f4a5dd270170f5862b6cabc0 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Fri, 4 Sep 2026 14:27:44 +0700
Subject: [PATCH] arm64: dts: qcom: eliza: add I2C6 on QUP1 SE6

Add the QUP1 SE6 serial engine (a98000) as an I2C controller along with
its pinctrl state so boards can enable I2C6.

The pin mux needs care. SE6 exposes its lanes such that L0/L2 are fixed
(no mirror) and remain collapsed under the generic "qup1_se6" function,
while L1/L3 have mira/mirb mirror alternates broken out as separate
functions. I2C on SE6 uses L0 (SDA) and L1 (SCL), so the routing is:

  - SDA: gpio40 -> function "qup1_se6"          (lane L0)
  - SCL: gpio42 -> function "qup1_se6_l1_mira"  (lane L1)

This matches the downstream configuration (qup1_se6_l0 + qup1_se6_l1_mira)
and relies on commit cef1554c4f7d ("pinctrl: qcom: eliza: Split QUP lane
mirror alternates"), which made qup1_se6_l1_mira individually selectable.

Muxing both pins to the generic "qup1_se6" leaves SCL on the wrong lane
(the controller reports "Timeout cancel_m_cmd"); muxing SDA to
"qup1_se6_l3_mira" (lane L3) instead of L0 leaves SDA off the bus (the
controller reports "Bus arbitration lost, clock line undriveable"). The
routing above brings the bus up.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>
---
 arch/arm64/boot/dts/qcom/eliza.dtsi | 47 +++++++++++++++++++++++++++++
 1 file changed, 47 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/eliza.dtsi b/arch/arm64/boot/dts/qcom/eliza.dtsi
index ad93b5f96a94..be59895768ce 100644
--- a/arch/arm64/boot/dts/qcom/eliza.dtsi
+++ b/arch/arm64/boot/dts/qcom/eliza.dtsi
@@ -1600,6 +1600,39 @@ &clk_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
 				status = "disabled";
 			};
 
+			i2c6: i2c@a98000 {
+				compatible = "qcom,geni-i2c";
+				reg = <0x0 0x00a98000 0x0 0x4000>;
+
+				interrupts = <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH>;
+
+				clocks = <&gcc GCC_QUPV3_WRAP1_S6_CLK>;
+				clock-names = "se";
+
+				interconnects = <&clk_virt MASTER_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS
+						 &clk_virt SLAVE_QUP_CORE_1 QCOM_ICC_TAG_ALWAYS>,
+						<&gem_noc MASTER_APPSS_PROC QCOM_ICC_TAG_ACTIVE_ONLY
+						 &config_noc SLAVE_QUP_1 QCOM_ICC_TAG_ACTIVE_ONLY>,
+						<&aggre1_noc MASTER_QUP_1 QCOM_ICC_TAG_ALWAYS
+						 &mc_virt SLAVE_EBI1 QCOM_ICC_TAG_ALWAYS>;
+				interconnect-names = "qup-core",
+						     "qup-config",
+						     "qup-memory";
+
+				dmas = <&gpi_dma1 0 6 QCOM_GPI_I2C>,
+				       <&gpi_dma1 1 6 QCOM_GPI_I2C>;
+				dma-names = "tx",
+					    "rx";
+
+				pinctrl-0 = <&qup_i2c6_data>, <&qup_i2c6_clk>;
+				pinctrl-names = "default";
+
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				status = "disabled";
+			};
+
 			uart6: serial@a98000 {
 				compatible = "qcom,geni-uart";
 				reg = <0x0 0x00a98000 0x0 0x4000>;
@@ -3333,6 +3366,20 @@ qup_uart6_default: qup-uart6-default-state {
 				bias-pull-up;
 			};
 
+			qup_i2c6_data: qup-i2c6-data-state {
+				pins = "gpio40";
+				function = "qup1_se6";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
+			qup_i2c6_clk: qup-i2c6-clk-state {
+				pins = "gpio42";
+				function = "qup1_se6_l1_mira";
+				drive-strength = <2>;
+				bias-pull-up;
+			};
+
 			qup_uart6_cts_rts: qup-uart6-cts-rts-state {
 				/* CTS, RTS */
 				pins = "gpio40", "gpio42";
-- 
2.55.0

