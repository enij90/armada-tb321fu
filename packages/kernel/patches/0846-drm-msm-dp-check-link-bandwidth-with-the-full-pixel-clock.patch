From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] drm/msm/dp: check link bandwidth with the full pixel clock

mode_valid halves the pixel clock when the controller uses wide bus, so
that the DP_MAX_PIXEL_CLK_KHZ check sees the DPU clock. The same halved
clock then went into the link bandwidth check, which made every mode
look like it needed half the link it really does. Behind a 2-lane HBR2
USB-C hub, 2560x1440@120 and 3840x1600@60 were accepted and then gave
no picture or a shaking one, with no audio.

Wide bus changes only how the DPU feeds the controller, not the data on
the link. Keep the halved clock for the max clock check and use the
mode clock (halved only for YUV 420) for the bpp choice and the
bandwidth check.

---
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -700,6 +700,7 @@
 	u32 mode_rate_khz = 0, supported_rate_khz = 0, mode_bpp = 0;
 	struct msm_dp *dp;
 	int mode_pclk_khz = mode->clock;
+	int link_pclk_khz;
 	bool is_yuv_420;
 
 	dp = to_dp_bridge(bridge)->msm_dp_display;
@@ -721,6 +722,9 @@
 	if (is_yuv_420 && !msm_dp_display->panel->vsc_sdp_supported)
 		return MODE_NO_420;
 
+	/* YUV 420 halves the data on the link, wide bus only the DPU clock */
+	link_pclk_khz = is_yuv_420 ? mode_pclk_khz / 2 : mode_pclk_khz;
+
 	if (is_yuv_420 || msm_dp_display->wide_bus_supported)
 		mode_pclk_khz /= 2;
 
@@ -732,9 +736,9 @@
 		mode_bpp = default_bpp;
 
 	mode_bpp = msm_dp_panel_get_mode_bpp(msm_dp_display->panel,
-			mode_bpp, mode_pclk_khz);
+			mode_bpp, link_pclk_khz);
 
-	mode_rate_khz = mode_pclk_khz * mode_bpp;
+	mode_rate_khz = link_pclk_khz * mode_bpp;
 	supported_rate_khz = link_info->num_lanes * link_info->rate * 8;
 
 	if (mode_rate_khz > supported_rate_khz)
