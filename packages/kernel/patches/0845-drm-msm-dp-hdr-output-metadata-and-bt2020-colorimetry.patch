+/* HDR metadata and colorimetry of the connector, for msm_dp_panel_timing_cfg() */
+static void msm_dp_display_set_hdr(struct msm_dp_display_private *dp,
+				   struct drm_bridge *bridge,
+				   struct drm_atomic_commit *state)
+{
+	struct msm_dp_panel *panel = dp->panel;
+	struct drm_connector_state *conn_state;
+	struct drm_connector *connector;
+
+	panel->hdr_enabled = false;
+	panel->bt2020 = false;
+	if (dp->msm_dp_display.is_edp)
+		return;
+
+	connector = drm_atomic_get_new_connector_for_encoder(state, bridge->encoder);
+	if (!connector)
+		return;
+	conn_state = drm_atomic_get_new_connector_state(state, connector);
+	if (!conn_state)
+		return;
+
+	panel->bt2020 = conn_state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB;
+	if (!msm_dp_utils_pack_hdr_sdp(conn_state, &panel->hdr_sdp))
+		panel->hdr_enabled = !!conn_state->hdr_output_metadata;
+
+	drm_dbg_dp(dp->drm_dev, "hdr=%d bt2020=%d bpp=%u\n", panel->hdr_enabled,
+		   panel->bt2020, dp->msm_dp_mode.bpp);
+}
