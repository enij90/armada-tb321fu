+/*
+ * HDR metadata and colorimetry go out with the stream (HDR InfoFrame SDP,
+ * VSC SDP), so a change in either takes a modeset.
+ */
+static int msm_dp_bridge_atomic_check(struct drm_bridge *drm_bridge,
+					  struct drm_bridge_state *bridge_state,
+					  struct drm_crtc_state *crtc_state,
+					  struct drm_connector_state *conn_state)
+{
+	struct drm_connector_state *old_state;
+	struct dp_sdp sdp;
+	int ret;
+
+	if (!conn_state)
+		return 0;
+
+	ret = msm_dp_utils_pack_hdr_sdp(conn_state, &sdp);
+	if (ret)
+		return ret;
+
+	old_state = drm_atomic_get_old_connector_state(conn_state->state,
+							   conn_state->connector);
+	if (old_state && (old_state->colorspace != conn_state->colorspace ||
+			  !drm_connector_atomic_hdr_metadata_equal(old_state, conn_state)))
+		crtc_state->mode_changed = true;
+
+	return 0;
+}
+
 static const struct drm_bridge_funcs msm_dp_bridge_ops = {
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
 	.atomic_destroy_state   = drm_atomic_helper_bridge_destroy_state,
 	.atomic_reset           = drm_atomic_helper_bridge_reset,
+	.atomic_check           = msm_dp_bridge_atomic_check,
 	.atomic_enable          = msm_dp_bridge_atomic_enable,
 	.atomic_disable         = msm_dp_bridge_atomic_disable,
 	.atomic_post_disable    = msm_dp_bridge_atomic_post_disable,
@@ -322,8 +354,13 @@
 	if (IS_ERR(connector))
 		return connector;
 
-	if (!msm_dp_display->is_edp)
+	if (!msm_dp_display->is_edp) {
 		drm_connector_attach_dp_subconnector_property(connector);
+		drm_connector_attach_hdr_output_metadata_property(connector);
+		if (!drm_mode_create_dp_colorspace_property(connector,
+								BIT(DRM_MODE_COLORIMETRY_BT2020_RGB)))
+			drm_connector_attach_colorspace_property(connector);
+	}
 
 	return connector;
 }
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -569,6 +569,77 @@
 	msm_dp_panel_update_sdp(panel);
 }
 
+static void msm_dp_panel_enable_hdr_sdp(struct msm_dp_panel_private *panel)
+{
+	struct dp_sdp *sdp = &panel->msm_dp_panel.hdr_sdp;
+	u32 header[2], cfg, val;
+	int i;
+
+	msm_dp_utils_pack_sdp_header(&sdp->sdp_header, header);
+	msm_dp_write_link(panel, MMSS_DP_GENERIC2_0, header[0]);
+	msm_dp_write_link(panel, MMSS_DP_GENERIC2_0 + 4, header[1]);
+	for (i = 0; i < sizeof(sdp->db); i += 4) {
+		val = sdp->db[i] | (sdp->db[i + 1] << 8) | (sdp->db[i + 2] << 16) |
+			  (sdp->db[i + 3] << 24);
+		msm_dp_write_link(panel, MMSS_DP_GENERIC2_0 + 8 + i, val);
+	}
+
+	cfg = msm_dp_read_link(panel, MMSS_DP_SDP_CFG2);
+	msm_dp_write_link(panel, MMSS_DP_SDP_CFG2, cfg | GENERIC2_SDPSIZE_VALID);
+	cfg = msm_dp_read_link(panel, MMSS_DP_SDP_CFG);
+	msm_dp_write_link(panel, MMSS_DP_SDP_CFG, cfg | GEN2_SDP_EN);
+
+	drm_dbg_dp(panel->drm_dev, "hdr sdp enable=1 eotf=%u\n", sdp->db[2]);
+
+	msm_dp_panel_update_sdp(panel);
+}
+
+void msm_dp_panel_disable_hdr_sdp(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel;
+	u32 cfg;
+
+	panel = container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+
+	cfg = msm_dp_read_link(panel, MMSS_DP_SDP_CFG);
+	if (!(cfg & GEN2_SDP_EN))
+		return;
+	msm_dp_write_link(panel, MMSS_DP_SDP_CFG, cfg & ~GEN2_SDP_EN);
+	cfg = msm_dp_read_link(panel, MMSS_DP_SDP_CFG2);
+	msm_dp_write_link(panel, MMSS_DP_SDP_CFG2, cfg & ~GENERIC2_SDPSIZE_VALID);
+
+	drm_dbg_dp(panel->drm_dev, "hdr sdp enable=0\n");
+
+	msm_dp_panel_update_sdp(panel);
+}
+
+/* RGB with BT.2020 colorimetry can only be signalled through the VSC SDP */
+static int msm_dp_panel_setup_vsc_sdp_bt2020(struct msm_dp_panel *msm_dp_panel)
+{
+	struct drm_dp_vsc_sdp vsc_sdp_data = {};
+	struct dp_sdp vsc_sdp;
+	ssize_t len;
+
+	vsc_sdp_data.sdp_type = DP_SDP_VSC;
+	vsc_sdp_data.revision = 0x05;
+	vsc_sdp_data.length = 0x13;
+	vsc_sdp_data.pixelformat = DP_PIXELFORMAT_RGB;
+	vsc_sdp_data.colorimetry = DP_COLORIMETRY_BT2020_RGB;
+	vsc_sdp_data.bpc = msm_dp_panel->msm_dp_mode.bpp / 3;
+	vsc_sdp_data.dynamic_range = DP_DYNAMIC_RANGE_VESA;
+	vsc_sdp_data.content_type = DP_CONTENT_TYPE_GRAPHICS;
+
+	len = drm_dp_vsc_sdp_pack(&vsc_sdp_data, &vsc_sdp);
+	if (len < 0) {
+		DRM_ERROR("unable to pack vsc sdp\n");
+		return len;
+	}
+
+	msm_dp_panel_enable_vsc_sdp(msm_dp_panel, &vsc_sdp);
+
+	return 0;
+}
+
 static int msm_dp_panel_setup_vsc_sdp_yuv_420(struct msm_dp_panel *msm_dp_panel)
 {
 	struct msm_dp_display_mode *msm_dp_mode;
@@ -683,6 +754,13 @@
 
 	if (msm_dp_panel->msm_dp_mode.out_fmt_is_yuv_420)
 		msm_dp_panel_setup_vsc_sdp_yuv_420(msm_dp_panel);
+	else if (msm_dp_panel->bt2020 && msm_dp_panel->vsc_sdp_supported)
+		msm_dp_panel_setup_vsc_sdp_bt2020(msm_dp_panel);
+
+	if (msm_dp_panel->hdr_enabled)
+		msm_dp_panel_enable_hdr_sdp(panel);
+	else
+		msm_dp_panel_disable_hdr_sdp(msm_dp_panel);
 
 	panel->panel_on = true;
 
