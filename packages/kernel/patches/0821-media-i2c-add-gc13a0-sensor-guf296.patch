From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] media: i2c: add GalaxyCore GC13A0 sensor driver (Lenovo TB321FU)

GUF296's bring-up driver for the GC13A0 13 MP rear main camera fitted to some
TB321FU units, from his linux tree at 51715124a767 ("Y700 adaptation for
v7.1-rc7 test"). Other units carry an OmniVision OV13B10 in the same slot
(see 0825); on those this driver fails to read the chip id and leaves the
node to ov13b10.

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index 5d173e0ec..1994212ca 100644
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -100,6 +100,16 @@ config VIDEO_GC08A3
 	  To compile this driver as a module, choose M here: the
 	  module will be called gc08a3.
 
+config VIDEO_GC13A0
+	tristate "GalaxyCore GC13A0 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a minimal Video4Linux2 bring-up driver for the GalaxyCore
+	  GC13A0 camera.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called gc13a0.
+
 config VIDEO_GC2145
 	select V4L2_CCI_I2C
 	tristate "GalaxyCore GC2145 sensor support"
diff --git a/drivers/media/i2c/Makefile b/drivers/media/i2c/Makefile
index e45359efe..5fa56355d 100644
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -41,6 +41,7 @@ obj-$(CONFIG_VIDEO_GC0308) += gc0308.o
 obj-$(CONFIG_VIDEO_GC0310) += gc0310.o
 obj-$(CONFIG_VIDEO_GC05A2) += gc05a2.o
 obj-$(CONFIG_VIDEO_GC08A3) += gc08a3.o
+obj-$(CONFIG_VIDEO_GC13A0) += gc13a0.o
 obj-$(CONFIG_VIDEO_GC2145) += gc2145.o
 obj-$(CONFIG_VIDEO_HI556) += hi556.o
 obj-$(CONFIG_VIDEO_HI846) += hi846.o
diff --git a/drivers/media/i2c/gc13a0-y700-regs.h b/drivers/media/i2c/gc13a0-y700-regs.h
new file mode 100644
