@@ -0,0 +1,884 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * V4L2 subdev driver for the GalaxyCore GC13A0 image sensor
+ *
+ * Copyright 2024 MediaTek
+ *
+ * Zhi Mao <zhi.mao@mediatek.com>
+ */
+#include <linux/array_size.h>
+#include <linux/bits.h>
+#include <linux/clk.h>
+#include <linux/container_of.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/math64.h>
+#include <linux/mod_devicetable.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/regulator/consumer.h>
+#include <linux/types.h>
+#include <linux/units.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define GC13A0_REG_TEST_PATTERN_EN CCI_REG8(0x008c)
+#define GC13A0_REG_TEST_PATTERN_IDX CCI_REG8(0x008d)
+#define GC13A0_TEST_PATTERN_EN 0x01
+
+#define GC13A0_STREAMING_REG CCI_REG8(0x0100)
+
+#define GC13A0_FLIP_REG CCI_REG8(0x0101)
+#define GC13A0_FLIP_H_MASK BIT(0)
+#define GC13A0_FLIP_V_MASK BIT(1)
+
+#define GC13A0_EXP_REG CCI_REG16(0x0202)
+#define GC13A0_EXP_MARGIN 16
+#define GC13A0_EXP_MIN 4
+#define GC13A0_EXP_STEP 1
+
+#define GC13A0_AGAIN_REG CCI_REG16(0x0204)
+#define GC13A0_AGAIN_MIN 1024
+#define GC13A0_AGAIN_MAX (1024 * 16)
+#define GC13A0_AGAIN_STEP 1
+
+#define GC13A0_FRAME_LENGTH_REG CCI_REG16(0x0340)
+#define GC13A0_VTS_MAX 0xfff0
+
+#define GC13A0_REG_CHIP_ID CCI_REG16(0x03f0)
+#define GC13A0_CHIP_ID 0x13a0
+
+#define GC13A0_NATIVE_WIDTH 4208
+#define GC13A0_NATIVE_HEIGHT 3120
+
+#define GC13A0_DEFAULT_CLK_FREQ 19200000
+#define GC13A0_MBUS_CODE MEDIA_BUS_FMT_SGRBG10_1X10
+#define GC13A0_DATA_LANES 4
+
+#define GC13A0_RGB_DEPTH 10
+
+#define GC13A0_SLEEP_US  (2 * USEC_PER_MSEC)
+
+static const char *const gc13a0_test_pattern_menu[] = {
+	"No Pattern", "Solid Black", "Colour Bar", "Solid White",
+	"Solid Red", "Solid Green", "Solid Blue", "Solid Yellow",
+};
+
+static const s64 gc13a0_link_freq_menu_items[] = {
+	(560 * HZ_PER_MHZ),
+};
+
+static const char *const gc13a0_supply_name[] = {
+	"avdd",
+	"dvdd",
+	"dovdd",
+};
+
+struct gc13a0 {
+	struct device *dev;
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct clk *xclk;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(gc13a0_supply_name)];
+	struct gpio_desc *reset_gpio;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+
+	struct regmap *regmap;
+	unsigned long link_freq_bitmap;
+	const struct gc13a0_mode *cur_mode;
+};
+
+struct gc13a0_reg_list {
+	u32 num_of_regs;
+	const struct cci_reg_sequence *regs;
+};
+
+#include "gc13a0-y700-regs.h"
+
+struct gc13a0_mode {
+	u32 width;
+	u32 height;
+	const struct gc13a0_reg_list reg_list;
+
+	u32 hts; /* Horizontal timining size */
+	u32 vts_def; /* Default vertical timining size */
+	u32 vts_min; /* Min vertical timining size */
+};
+
+/* Declare modes in order, from biggest to smallest height. */
+static const struct gc13a0_mode gc13a0_modes[] = {
+	{
+		.width = GC13A0_NATIVE_WIDTH,
+		.height = GC13A0_NATIVE_HEIGHT,
+		.reg_list = {
+			.num_of_regs = ARRAY_SIZE(gc13a0_y700_mode_4208x3120_regs),
+			.regs = gc13a0_y700_mode_4208x3120_regs,
+		},
+		.hts = 4704,
+		.vts_def = 3240,
+		.vts_min = 3240,
+	},
+};
+
+static inline struct gc13a0 *to_gc13a0(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct gc13a0, sd);
+}
+
+static int gc13a0_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc13a0 *gc13a0 = to_gc13a0(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(gc13a0_supply_name),
+				    gc13a0->supplies);
+	if (ret < 0) {
+		dev_err(gc13a0->dev, "failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(gc13a0->xclk);
+	if (ret < 0) {
+		regulator_bulk_disable(ARRAY_SIZE(gc13a0_supply_name),
+				       gc13a0->supplies);
+		dev_err(gc13a0->dev, "clk prepare enable failed\n");
+		return ret;
+	}
+
+	fsleep(GC13A0_SLEEP_US);
+
+	gpiod_set_value_cansleep(gc13a0->reset_gpio, 0);
+	fsleep(GC13A0_SLEEP_US);
+
+	return 0;
+}
+
+static int gc13a0_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct gc13a0 *gc13a0 = to_gc13a0(sd);
+
+	clk_disable_unprepare(gc13a0->xclk);
+	gpiod_set_value_cansleep(gc13a0->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(gc13a0_supply_name),
+			       gc13a0->supplies);
+
+	return 0;
+}
+
+static int gc13a0_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = GC13A0_MBUS_CODE;
+
+	return 0;
+}
+
+static int gc13a0_enum_frame_size(struct v4l2_subdev *subdev,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->code != GC13A0_MBUS_CODE)
+		return -EINVAL;
+
+	if (fse->index >= ARRAY_SIZE(gc13a0_modes))
+		return -EINVAL;
+
+	fse->min_width = gc13a0_modes[fse->index].width;
+	fse->max_width = gc13a0_modes[fse->index].width;
+	fse->min_height = gc13a0_modes[fse->index].height;
+	fse->max_height = gc13a0_modes[fse->index].height;
+
+	return 0;
+}
+
+static int gc13a0_update_cur_mode_controls(struct gc13a0 *gc13a0,
+					   const struct gc13a0_mode *mode)
+{
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ret = __v4l2_ctrl_modify_range(gc13a0->vblank,
+				       mode->vts_min - mode->height,
+				       GC13A0_VTS_MAX - mode->height, 1,
+				       mode->vts_def - mode->height);
+	if (ret) {
+		dev_err(gc13a0->dev, "VB ctrl range update failed\n");
+		return ret;
+	}
+
+	h_blank = mode->hts - mode->width;
+	ret = __v4l2_ctrl_modify_range(gc13a0->hblank, h_blank, h_blank, 1,
+				       h_blank);
+	if (ret) {
+		dev_err(gc13a0->dev, "HB ctrl range update failed\n");
+		return ret;
+	}
+
+	exposure_max = mode->vts_def - GC13A0_EXP_MARGIN;
+	ret = __v4l2_ctrl_modify_range(gc13a0->exposure, GC13A0_EXP_MIN,
+				       exposure_max, GC13A0_EXP_STEP,
+				       exposure_max);
+	if (ret) {
+		dev_err(gc13a0->dev, "exposure ctrl range update failed\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void gc13a0_update_pad_format(struct gc13a0 *gc13a0,
+				     const struct gc13a0_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->code = GC13A0_MBUS_CODE;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_MAP_YCBCR_ENC_DEFAULT(fmt->colorspace);
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int gc13a0_set_format(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state,
+			     struct v4l2_subdev_format *fmt)
+{
+	struct gc13a0 *gc13a0 = to_gc13a0(sd);
+	struct v4l2_mbus_framefmt *mbus_fmt;
+	struct v4l2_rect *crop;
+	const struct gc13a0_mode *mode;
+
+	mode = v4l2_find_nearest_size(gc13a0_modes, ARRAY_SIZE(gc13a0_modes),
+				      width, height, fmt->format.width,
+				      fmt->format.height);
+
+	/* update crop info to subdev state */
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	crop->width = mode->width;
+	crop->height = mode->height;
+
+	/* update fmt info to subdev state */
+	gc13a0_update_pad_format(gc13a0, mode, &fmt->format);
+	mbus_fmt = v4l2_subdev_state_get_format(state, 0);
+	*mbus_fmt = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY)
+		return 0;
+
+	gc13a0->cur_mode = mode;
+	gc13a0_update_cur_mode_controls(gc13a0, mode);
+
+	return 0;
+}
+
+static int gc13a0_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		break;
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.top = 0;
+		sel->r.left = 0;
+		sel->r.width = GC13A0_NATIVE_WIDTH;
+		sel->r.height = GC13A0_NATIVE_HEIGHT;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int gc13a0_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = GC13A0_MBUS_CODE,
+			.width = gc13a0_modes[0].width,
+			.height = gc13a0_modes[0].height,
+		},
+	};
+
+	gc13a0_set_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static int gc13a0_set_ctrl_hflip(struct gc13a0 *gc13a0, u32 ctrl_val)
+{
+	int ret;
+	u64 val;
+
+	ret = cci_read(gc13a0->regmap, GC13A0_FLIP_REG, &val, NULL);
+	if (ret) {
+		dev_err(gc13a0->dev, "read hflip register failed: %d\n", ret);
+		return ret;
+	}
+
+	return cci_update_bits(gc13a0->regmap, GC13A0_FLIP_REG,
+			       GC13A0_FLIP_H_MASK,
+			       ctrl_val ? GC13A0_FLIP_H_MASK : 0, NULL);
+}
+
+static int gc13a0_set_ctrl_vflip(struct gc13a0 *gc13a0, u32 ctrl_val)
+{
+	int ret;
+	u64 val;
+
+	ret = cci_read(gc13a0->regmap, GC13A0_FLIP_REG, &val, NULL);
+	if (ret) {
+		dev_err(gc13a0->dev, "read vflip register failed: %d\n", ret);
+		return ret;
+	}
+
+	return cci_update_bits(gc13a0->regmap, GC13A0_FLIP_REG,
+			       GC13A0_FLIP_V_MASK,
+			       ctrl_val ? GC13A0_FLIP_V_MASK : 0, NULL);
+}
+
+static int gc13a0_test_pattern(struct gc13a0 *gc13a0, u32 pattern_menu)
+{
+	u32 pattern;
+	int ret;
+
+	if (pattern_menu) {
+		switch (pattern_menu) {
+		case 1:
+			pattern = 0x00;
+			break;
+		case 2:
+			pattern = 0x10;
+			break;
+		case 3:
+		case 4:
+		case 5:
+		case 6:
+		case 7:
+			pattern = pattern_menu + 1;
+			break;
+		default:
+			pattern = 0x00;
+			break;
+		}
+
+		ret = cci_write(gc13a0->regmap, GC13A0_REG_TEST_PATTERN_IDX,
+				pattern, NULL);
+		if (ret)
+			return ret;
+
+		return cci_write(gc13a0->regmap, GC13A0_REG_TEST_PATTERN_EN,
+				 GC13A0_TEST_PATTERN_EN, NULL);
+	} else {
+		return cci_write(gc13a0->regmap, GC13A0_REG_TEST_PATTERN_EN,
+				 0x00, NULL);
+	}
+}
+
+static int gc13a0_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct gc13a0 *gc13a0 =
+		container_of(ctrl->handler, struct gc13a0, ctrls);
+	int ret = 0;
+	s64 exposure_max;
+	struct v4l2_subdev_state *state;
+	const struct v4l2_mbus_framefmt *format;
+
+	state = v4l2_subdev_get_locked_active_state(&gc13a0->sd);
+	format = v4l2_subdev_state_get_format(state, 0);
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = format->height + ctrl->val - GC13A0_EXP_MARGIN;
+		__v4l2_ctrl_modify_range(gc13a0->exposure,
+					 gc13a0->exposure->minimum,
+					 exposure_max, gc13a0->exposure->step,
+					 exposure_max);
+	}
+
+	/*
+	 * Applying V4L2 control value only happens
+	 * when power is on for streaming.
+	 */
+	if (!pm_runtime_get_if_active(gc13a0->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(gc13a0->regmap, GC13A0_EXP_REG,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(gc13a0->regmap, GC13A0_AGAIN_REG,
+				ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_VBLANK:
+		ret = cci_write(gc13a0->regmap, GC13A0_FRAME_LENGTH_REG,
+				gc13a0->cur_mode->height + ctrl->val, NULL);
+		break;
+
+	case V4L2_CID_HFLIP:
+		ret = gc13a0_set_ctrl_hflip(gc13a0, ctrl->val);
+		break;
+
+	case V4L2_CID_VFLIP:
+		ret = gc13a0_set_ctrl_vflip(gc13a0, ctrl->val);
+		break;
+
+	case V4L2_CID_TEST_PATTERN:
+		ret = gc13a0_test_pattern(gc13a0, ctrl->val);
+		break;
+
+	default:
+		break;
+	}
+
+	pm_runtime_put(gc13a0->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops gc13a0_ctrl_ops = {
+	.s_ctrl = gc13a0_set_ctrl,
+};
+
+static int gc13a0_start_streaming(struct gc13a0 *gc13a0)
+{
+	const struct gc13a0_reg_list *reg_list;
+	const struct gc13a0_mode *mode;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(gc13a0->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(gc13a0->regmap, gc13a0_y700_init_regs,
+				  ARRAY_SIZE(gc13a0_y700_init_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	mode = gc13a0->cur_mode;
+	reg_list = &mode->reg_list;
+	ret = cci_multi_reg_write(gc13a0->regmap, reg_list->regs,
+				  reg_list->num_of_regs, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&gc13a0->ctrls);
+	if (ret) {
+		dev_err(gc13a0->dev, "could not sync v4l2 controls\n");
+		goto err_rpm_put;
+	}
+
+	ret = cci_write(gc13a0->regmap, GC13A0_STREAMING_REG, 1, NULL);
+	if (ret) {
+		dev_err(gc13a0->dev, "write streaming register failed: %d\n", ret);
+		goto err_rpm_put;
+	}
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(gc13a0->dev);
+	return ret;
+}
+
+static int gc13a0_stop_streaming(struct gc13a0 *gc13a0)
+{
+	int ret;
+
+	ret = cci_write(gc13a0->regmap, GC13A0_STREAMING_REG, 0, NULL);
+	if (ret)
+		dev_err(gc13a0->dev, "could not stop streaming: %d\n", ret);
+
+	pm_runtime_put(gc13a0->dev);
+
+	return ret;
+}
+
+static int gc13a0_s_stream(struct v4l2_subdev *subdev, int enable)
+{
+	struct gc13a0 *gc13a0 = to_gc13a0(subdev);
+	struct v4l2_subdev_state *state;
+	int ret;
+
+	state = v4l2_subdev_lock_and_get_active_state(subdev);
+
+	if (enable)
+		ret = gc13a0_start_streaming(gc13a0);
+	else
+		ret = gc13a0_stop_streaming(gc13a0);
+
+	v4l2_subdev_unlock_state(state);
+
+	return ret;
+}
+
+static const struct v4l2_subdev_video_ops gc13a0_video_ops = {
+	.s_stream = gc13a0_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops gc13a0_subdev_pad_ops = {
+	.enum_mbus_code = gc13a0_enum_mbus_code,
+	.enum_frame_size = gc13a0_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = gc13a0_set_format,
+	.get_selection = gc13a0_get_selection,
+};
+
+static const struct v4l2_subdev_ops gc13a0_subdev_ops = {
+	.video = &gc13a0_video_ops,
+	.pad = &gc13a0_subdev_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops gc13a0_internal_ops = {
+	.init_state = gc13a0_init_state,
+};
+
+static int gc13a0_get_regulators(struct device *dev, struct gc13a0 *gc13a0)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(gc13a0_supply_name); i++)
+		gc13a0->supplies[i].supply = gc13a0_supply_name[i];
+
+	return devm_regulator_bulk_get(dev, ARRAY_SIZE(gc13a0_supply_name),
+				       gc13a0->supplies);
+}
+
+static int gc13a0_parse_fwnode(struct gc13a0 *gc13a0)
+{
+	struct fwnode_handle *endpoint;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	int ret;
+	struct device *dev = gc13a0->dev;
+
+	endpoint =
+		fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 0, 0,
+						FWNODE_GRAPH_ENDPOINT_NEXT);
+	if (!endpoint) {
+		dev_err(dev, "endpoint node not found\n");
+		return -EINVAL;
+	}
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(endpoint, &bus_cfg);
+	if (ret) {
+		dev_err(dev, "parsing endpoint node failed\n");
+		goto done;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       gc13a0_link_freq_menu_items,
+				       ARRAY_SIZE(gc13a0_link_freq_menu_items),
+				       &gc13a0->link_freq_bitmap);
+	if (ret)
+		goto done;
+
+done:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+	fwnode_handle_put(endpoint);
+	return ret;
+}
+
+static u64 gc13a0_to_pixel_rate(u32 f_index)
+{
+	u64 pixel_rate =
+		gc13a0_link_freq_menu_items[f_index] * 2 * GC13A0_DATA_LANES;
+
+	return div_u64(pixel_rate, GC13A0_RGB_DEPTH);
+}
+
+static int gc13a0_init_controls(struct gc13a0 *gc13a0)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&gc13a0->sd);
+	const struct gc13a0_mode *mode = &gc13a0_modes[0];
+	const struct v4l2_ctrl_ops *ops = &gc13a0_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl_handler *ctrl_hdlr;
+	s64 exposure_max, h_blank;
+	int ret;
+
+	ctrl_hdlr = &gc13a0->ctrls;
+	ret = v4l2_ctrl_handler_init(ctrl_hdlr, 9);
+	if (ret)
+		return ret;
+
+	gc13a0->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &gc13a0_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	gc13a0->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &gc13a0_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &gc13a0->hflip);
+
+	gc13a0->link_freq =
+	v4l2_ctrl_new_int_menu(ctrl_hdlr,
+			       &gc13a0_ctrl_ops,
+			       V4L2_CID_LINK_FREQ,
+			       ARRAY_SIZE(gc13a0_link_freq_menu_items) - 1,
+			       0,
+			       gc13a0_link_freq_menu_items);
+	if (gc13a0->link_freq)
+		gc13a0->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	gc13a0->pixel_rate =
+		v4l2_ctrl_new_std(ctrl_hdlr,
+				  &gc13a0_ctrl_ops,
+				  V4L2_CID_PIXEL_RATE, 0,
+				  gc13a0_to_pixel_rate(0),
+				  1,
+				  gc13a0_to_pixel_rate(0));
+
+	gc13a0->vblank =
+		v4l2_ctrl_new_std(ctrl_hdlr,
+				  &gc13a0_ctrl_ops, V4L2_CID_VBLANK,
+				  mode->vts_min - mode->height,
+				  GC13A0_VTS_MAX - mode->height, 1,
+				  mode->vts_def - mode->height);
+
+	h_blank = mode->hts - mode->width;
+	gc13a0->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &gc13a0_ctrl_ops,
+					   V4L2_CID_HBLANK, h_blank, h_blank, 1,
+					   h_blank);
+	if (gc13a0->hblank)
+		gc13a0->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &gc13a0_ctrl_ops,
+			  V4L2_CID_ANALOGUE_GAIN, GC13A0_AGAIN_MIN,
+			  GC13A0_AGAIN_MAX, GC13A0_AGAIN_STEP,
+			  GC13A0_AGAIN_MIN);
+
+	exposure_max = mode->vts_def - GC13A0_EXP_MARGIN;
+	gc13a0->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &gc13a0_ctrl_ops,
+					     V4L2_CID_EXPOSURE, GC13A0_EXP_MIN,
+					     exposure_max, GC13A0_EXP_STEP,
+					     exposure_max);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &gc13a0_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(gc13a0_test_pattern_menu) - 1,
+				     0, 0, gc13a0_test_pattern_menu);
+
+	/* register properties to fwnode (e.g. rotation, orientation) */
+	ret = v4l2_fwnode_device_parse(&client->dev, &props);
+	if (ret)
+		goto error_ctrls;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, ops, &props);
+	if (ret)
+		goto error_ctrls;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_ctrls;
+	}
+
+	gc13a0->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_ctrls:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int gc13a0_identify_module(struct gc13a0 *gc13a0)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(gc13a0->regmap, GC13A0_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(gc13a0->dev, "failed to read chip id");
+		return ret;
+	}
+
+	if (val != GC13A0_CHIP_ID) {
+		dev_err(gc13a0->dev, "chip id mismatch: 0x%x!=0x%llx",
+			GC13A0_CHIP_ID, val);
+		return -ENXIO;
+	}
+
+	dev_dbg(gc13a0->dev, "GC13A0 chip id read: 0x%04llx\n", val);
+
+	return 0;
+}
+
+static int gc13a0_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct gc13a0 *gc13a0;
+	int ret;
+
+	gc13a0 = devm_kzalloc(dev, sizeof(*gc13a0), GFP_KERNEL);
+	if (!gc13a0)
+		return -ENOMEM;
+
+	gc13a0->dev = dev;
+
+	ret = gc13a0_parse_fwnode(gc13a0);
+	if (ret)
+		return ret;
+
+	gc13a0->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(gc13a0->regmap))
+		return dev_err_probe(dev, PTR_ERR(gc13a0->regmap),
+				     "failed to init CCI\n");
+
+	gc13a0->xclk = devm_v4l2_sensor_clk_get_legacy(dev, NULL, true,
+						       GC13A0_DEFAULT_CLK_FREQ);
+	if (IS_ERR(gc13a0->xclk))
+		return dev_err_probe(dev, PTR_ERR(gc13a0->xclk),
+				     "failed to get xclk\n");
+
+	ret = gc13a0_get_regulators(dev, gc13a0);
+	if (ret < 0)
+		return dev_err_probe(dev, ret,
+				     "failed to get regulators\n");
+
+	gc13a0->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(gc13a0->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(gc13a0->reset_gpio),
+				     "failed to get gpio\n");
+
+	v4l2_i2c_subdev_init(&gc13a0->sd, client, &gc13a0_subdev_ops);
+	gc13a0->sd.internal_ops = &gc13a0_internal_ops;
+	gc13a0->cur_mode = &gc13a0_modes[0];
+
+	ret = gc13a0_power_on(gc13a0->dev);
+	if (ret)
+		return dev_err_probe(dev, ret,
+				     "failed to sensor power on\n");
+
+	ret = gc13a0_identify_module(gc13a0);
+	if (ret) {
+		dev_err(&client->dev, "failed to find sensor: %d\n", ret);
+		goto err_power_off;
+	}
+
+	ret = gc13a0_init_controls(gc13a0);
+	if (ret) {
+		dev_err(&client->dev, "failed to init controls: %d", ret);
+		goto err_power_off;
+	}
+
+	gc13a0->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	gc13a0->pad.flags = MEDIA_PAD_FL_SOURCE;
+	gc13a0->sd.dev = &client->dev;
+	gc13a0->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = media_entity_pads_init(&gc13a0->sd.entity, 1, &gc13a0->pad);
+	if (ret < 0) {
+		dev_err(dev, "could not register media entity\n");
+		goto err_v4l2_ctrl_handler_free;
+	}
+
+	gc13a0->sd.state_lock = gc13a0->ctrls.lock;
+	ret = v4l2_subdev_init_finalize(&gc13a0->sd);
+	if (ret < 0) {
+		dev_err(dev, "v4l2 subdev init error: %d\n", ret);
+		goto err_media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(gc13a0->dev);
+	pm_runtime_enable(gc13a0->dev);
+	pm_runtime_set_autosuspend_delay(gc13a0->dev, 1000);
+	pm_runtime_use_autosuspend(gc13a0->dev);
+	pm_runtime_idle(gc13a0->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&gc13a0->sd);
+	if (ret < 0) {
+		dev_err(dev, "could not register v4l2 device\n");
+		goto err_rpm;
+	}
+
+	return 0;
+
+err_rpm:
+	pm_runtime_disable(gc13a0->dev);
+	v4l2_subdev_cleanup(&gc13a0->sd);
+
+err_media_entity_cleanup:
+	media_entity_cleanup(&gc13a0->sd.entity);
+
+err_v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(gc13a0->sd.ctrl_handler);
+
+err_power_off:
+	gc13a0_power_off(gc13a0->dev);
+
+	return ret;
+}
+
+static void gc13a0_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct gc13a0 *gc13a0 = to_gc13a0(sd);
+
+	v4l2_async_unregister_subdev(&gc13a0->sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&gc13a0->sd.entity);
+	v4l2_ctrl_handler_free(&gc13a0->ctrls);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		gc13a0_power_off(gc13a0->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct of_device_id gc13a0_of_match[] = {
+	{ .compatible = "galaxycore,gc13a0" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gc13a0_of_match);
+
+static DEFINE_RUNTIME_DEV_PM_OPS(gc13a0_pm_ops,
+				 gc13a0_power_off,
+				 gc13a0_power_on,
+				 NULL);
+
+static struct i2c_driver gc13a0_i2c_driver = {
+	.driver = {
+		.of_match_table = gc13a0_of_match,
+		.pm = pm_ptr(&gc13a0_pm_ops),
+		.name  = "gc13a0",
+	},
+	.probe  = gc13a0_probe,
+	.remove = gc13a0_remove,
+};
+module_i2c_driver(gc13a0_i2c_driver);
+
