+/*
+ * DisplayPort with DSC. The DP controller packs all slices of a line in one
+ * packet and paces the compressed stream with a DTO that, at 8 bpp, lets one
+ * pixel clock in three through. The interface and the DP controller must
+ * agree on the number of clocks that carry data, so both use these helpers.
+ * Numbers from Qualcomm's downstream dp_panel.c (DSC_TGT_BPP 8, wide bus).
+ */
+#define MSM_DSC_DP_DTO_N	1
+#define MSM_DSC_DP_DTO_D	3
+
+/* Bytes of padding that round the compressed line up to a multiple of 3 */
+static inline u32 msm_dsc_dp_eol_bytes(const struct drm_dsc_config *dsc)
+{
+	u32 bytes = msm_dsc_get_bytes_per_line(dsc);
+
+	return (3 - bytes % 3) % 3;
+}
+
+/* Wide bus clocks (6 bytes each) that carry the compressed line */
+static inline u32 msm_dsc_dp_data_clocks(const struct drm_dsc_config *dsc)
+{
+	return DIV_ROUND_UP(msm_dsc_get_bytes_per_line(dsc), 6);
+}
+
+/* Value for MMSS_DP_DSC_DTO_COUNT and the interface data window */
+static inline u32 msm_dsc_dp_pclk_per_line(const struct drm_dsc_config *dsc)
+{
+	return msm_dsc_dp_data_clocks(dsc) - 1;
+}
+
+/*
+ * Pixel clocks the interface must add to the active width when the last,
+ * incomplete DTO period of the line cannot hold the remaining data clocks.
+ */
+static inline u32 msm_dsc_dp_extra_width(const struct drm_dsc_config *dsc)
+{
+	u32 line_width = dsc->pic_width / 2;
+	u32 n = MSM_DSC_DP_DTO_N, d = MSM_DSC_DP_DTO_D;
+	int last_few_ack, accum = 0, needed = 0;
+	u32 remainder = n, start;
+	u32 last_few_pclk = line_width % d;
+
+	last_few_ack = msm_dsc_dp_data_clocks(dsc) - (line_width / d) * n;
+
+	while (accum < last_few_ack) {
+		needed++;
+		start = remainder >= n ? remainder : remainder + d;
+		remainder = start - n;
+		if (remainder < n)
+			accum++;
+	}
+
+	return last_few_pclk < needed ? needed - last_few_pclk : 0;
+}
