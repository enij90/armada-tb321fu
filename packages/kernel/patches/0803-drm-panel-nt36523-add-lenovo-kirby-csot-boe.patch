From: enij90 <226572015+enij90@users.noreply.github.com>
Subject: [PATCH] drm/panel: nt36523: add Lenovo TB321FU kirby CSOT + BOE DSC panels

Port of GUF296's kirby support (github.com/GUF296/linux, TB321FU-7.1.1) plus
the BOE variant (Legion Tab Gen 3 units with a BOE panel). Known-good on the
device with the 7.1.1 kernel; adapted to 7.2 (devm_drm_panel_alloc, no
dsc_slice_per_pkt field - the msm host default of 1 is what GUF set).

--- a/drivers/gpu/drm/panel/panel-novatek-nt36523.c	2026-09-28 11:25:48.499477147 +0200
+++ b/drivers/gpu/drm/panel/panel-novatek-nt36523.c	2026-09-28 11:25:48.502780765 +0200
@@ -15,6 +15,8 @@
 
 #include <video/mipi_display.h>
 
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
 #include <drm/drm_connector.h>
 #include <drm/drm_crtc.h>
 #include <drm/drm_mipi_dsi.h>
@@ -23,6 +25,31 @@
 
 #define DSI_NUM_MIN 1
 
+static int nt36523_dcs_write_buf(struct mipi_dsi_device *dsi,
+				 const u8 *buf, size_t len)
+{
+	ssize_t ret;
+
+	ret = mipi_dsi_dcs_write_buffer(dsi, buf, len);
+
+	return ret < 0 ? ret : 0;
+}
+
+#define mipi_dsi_dcs_write_seq(dsi, seq...)			\
+	do {							\
+		static const u8 d[] = { seq };			\
+								\
+		nt36523_dcs_write_buf(dsi, d, ARRAY_SIZE(d));	\
+	} while (0)
+
+#define mipi_dsi_dual_dcs_write_seq(dsi0, dsi1, seq...)		\
+	do {								\
+		static const u8 d[] = { seq };				\
+									\
+		nt36523_dcs_write_buf(dsi0, d, ARRAY_SIZE(d));		\
+		nt36523_dcs_write_buf(dsi1, d, ARRAY_SIZE(d));		\
+	} while (0)
+
 struct panel_info {
 	struct drm_panel panel;
 	struct mipi_dsi_device *dsi[2];
@@ -32,6 +59,9 @@
 	struct gpio_desc *reset_gpio;
 	struct backlight_device *backlight;
 	struct regulator *vddio;
+	struct regulator *enp;
+	struct regulator *enn;
+	struct drm_dsc_config dsc;
 };
 
 struct panel_desc {
@@ -50,6 +80,8 @@
 
 	bool is_dual_dsi;
 	bool has_dcs_backlight;
+	bool has_dsc;
+	bool display_on_after_dsc;
 };
 
