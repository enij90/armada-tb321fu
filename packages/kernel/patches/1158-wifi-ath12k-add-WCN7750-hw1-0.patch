From a432a615be0498793cde6a7524a2746e547c87e6 Mon Sep 17 00:00:00 2001
From: Teguh Sobirin <teguh@sobir.in>
Date: Tue, 8 Sep 2026 22:37:39 +0000
Subject: [PATCH] wifi: ath12k: add WCN7750 hw1.0

WCN7750 is a QCC2072-class part whose WLAN Q6 runs on the SoC WPSS
remoteproc. It shares the qcc2072 HAL and datapath; the bus, firmware
memory model, shadow register base and CE configuration differ. Add the
hw_rev, hw_params and HAL map entry, and bounds-check the map.

Signed-off-by: Teguh Sobirin <teguh@sobir.in>

Backport to Armada Linux 7.2.6; retain existing WCN7860 and QDSS support. Omit supports_cong_ctrl_max_msdus, absent in 7.2.
Source: https://github.com/RetroidPocket/linux/commit/a432a615be0498793cde6a7524a2746e547c87e6
---
diff --git a/drivers/net/wireless/ath/ath12k/core.h b/drivers/net/wireless/ath/ath12k/core.h
--- a/drivers/net/wireless/ath/ath12k/core.h
+++ b/drivers/net/wireless/ath/ath12k/core.h
@@ -164,6 +164,7 @@
 	ATH12K_HW_WCN7860_HW20,
 	ATH12K_HW_QCC2072_HW10,
 	ATH12K_HW_IPQ5424_HW10,
+	ATH12K_HW_WCN7750_HW10,
 };
 
 enum ath12k_firmware_mode {
diff --git a/drivers/net/wireless/ath/ath12k/qmi.h b/drivers/net/wireless/ath/ath12k/qmi.h
--- a/drivers/net/wireless/ath/ath12k/qmi.h
+++ b/drivers/net/wireless/ath/ath12k/qmi.h
@@ -18,6 +18,9 @@
 #define ATH12K_QMI_WLFW_SERVICE_VERS_V01	0x01
 #define ATH12K_QMI_WLFW_SERVICE_INS_ID_V01	0x02
 #define ATH12K_QMI_WLFW_SERVICE_INS_ID_V01_WCN7850 0x1
+
+/* WLFW_SERVICE_WCN_INS_ID_V01: WPSS-hosted parts */
+#define ATH12K_QMI_WLFW_SERVICE_INS_ID_V01_WCN7750 0x3
 
 #define ATH12K_QMI_WLFW_SERVICE_INS_ID_V01_QCN9274	0x07
 #define ATH12K_QMI_WLFW_SERVICE_INS_ID_V01_IPQ5332	0x2
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hal.c b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
--- a/drivers/net/wireless/ath/ath12k/wifi7/hal.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hal.c
@@ -64,6 +64,14 @@
 		.hal_params = &ath12k_hw_hal_params_ipq5332,
 		.hw_regs = &ipq5424_regs,
 	},
+	/* same HAL as qcc2072 */
+	[ATH12K_HW_WCN7750_HW10] = {
+		.hal_ops = &hal_qcc2072_ops,
+		.hal_desc_sz = sizeof(struct hal_rx_desc_qcc2072),
+		.tcl_to_wbm_rbm_map = ath12k_hal_tcl_to_wbm_rbm_map_wcn7850,
+		.hal_params = &ath12k_hw_hal_params_wcn7850,
+		.hw_regs = &qcc2072_regs,
+	},
 };
 
 int ath12k_wifi7_hal_init(struct ath12k_base *ab)
@@ -71,6 +79,14 @@
 	struct ath12k_hal *hal = &ab->hal;
 
 	memset(hal, 0, sizeof(*hal));
+
+	/* an unknown hw_rev would index past the table */
+	if (ab->hw_rev >= ARRAY_SIZE(ath12k_wifi7_hw_ver_map) ||
+	    !ath12k_wifi7_hw_ver_map[ab->hw_rev].hal_ops) {
+		ath12k_err(ab, "no Wi-Fi 7 HAL version map for hw_rev %d\n",
+			   ab->hw_rev);
+		return -EOPNOTSUPP;
+	}
 
 	hal->ops = ath12k_wifi7_hw_ver_map[ab->hw_rev].hal_ops;
 	hal->hal_desc_sz = ath12k_wifi7_hw_ver_map[ab->hw_rev].hal_desc_sz;
diff --git a/drivers/net/wireless/ath/ath12k/wifi7/hw.c b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
--- a/drivers/net/wireless/ath/ath12k/wifi7/hw.c
+++ b/drivers/net/wireless/ath/ath12k/wifi7/hw.c
@@ -977,6 +977,109 @@
 		},
 
 		.host_alloc_ml_id = true,
+	},
+	{
+		/* qcc2072 datapath; the WLAN Q6 runs on the WPSS remoteproc */
+		.name = "wcn7750 hw1.0",
+		.hw_rev = ATH12K_HW_WCN7750_HW10,
+
+		.fw = {
+			.dir = "WCN7750/hw1.0",
+			.board_size = 256 * 1024,
+			.cal_offset = 256 * 1024,
+			/* pulled over QMI by the Q6 (icnss_load_phy_ucode()/icnss_load_aux()) */
+			.m3_loader = ath12k_m3_fw_loader_driver,
+			.download_aux_ucode = true,
+		},
+
+		.max_radios = 1,
+		.single_pdev_only = true,
+		.qmi_service_ins_id = ATH12K_QMI_WLFW_SERVICE_INS_ID_V01_WCN7750,
+
+		.fixed_fw_mem = true,
+		.internal_sleep_clock = true,
+
+		.hw_ops = &qcc2072_ops,
+		.ring_mask = &ath12k_wifi7_hw_ring_mask_wcn7850,
+
+		.host_ce_config = ath12k_wifi7_host_ce_config_wcn7750,
+		.ce_count = 9,
+		.target_ce_config = ath12k_wifi7_target_ce_config_wlan_wcn7750,
+		.target_ce_count = 9,
+		.svc_to_ce_map =
+			ath12k_wifi7_target_service_to_ce_map_wlan_wcn7750,
+		.svc_to_ce_map_len = 15,
+
+		.rxdma1_enable = false,
+		.num_rxdma_per_pdev = 2,
+		.num_rxdma_dst_ring = 1,
+		.rx_mac_buf_ring = true,
+		.vdev_start_delay = true,
+
+		.interface_modes = BIT(NL80211_IFTYPE_STATION) |
+				   BIT(NL80211_IFTYPE_AP) |
+				   BIT(NL80211_IFTYPE_P2P_DEVICE) |
+				   BIT(NL80211_IFTYPE_P2P_CLIENT) |
+				   BIT(NL80211_IFTYPE_P2P_GO),
+		.supports_monitor = true,
+
+		.idle_ps = true,
+		.download_calib = false,
+		.supports_suspend = true,
+		.tcl_ring_retry = false,
+		.reoq_lut_support = false,
+
+		/* below ATH12K_PCI_WINDOW_START, so written straight to the BAR */
+		.supports_shadow_regs = true,
+		.hal_shadow_base_addr = HAL_SHADOW_BASE_ADDR_WCN7750,
+
+		.supports_coldboot_cal = true,
+
+		.num_tcl_banks = 7,
+		.max_tx_ring = 3,
+
+		.mhi_config = NULL,
+
+		.wmi_init = ath12k_wifi7_wmi_init_wcn7850,
+
+		/* QDSS_CFG_MISS must stay clear: the firmware needs the trace config */
+		.qmi_cnss_feature_bitmap = BIT(CNSS_AUX_UC_SUPPORT_V01),
+
+		.rfkill_pin = 0,
+		.rfkill_cfg = 0,
+		.rfkill_on_level = 0,
+
+		.rddm_size = 0,
+
+		.def_num_link = 2,
+		.max_mlo_peer = 32,
+
+		.otp_board_id_register = 0,
+
+		.supports_sta_ps = true,
+
+		.acpi_guid = NULL,
+		.supports_dynamic_smps_6ghz = false,
+
+		.iova_mask = 0,
+
+		.supports_aspm = false,
+
+		.ce_ie_addr = NULL,
+		/* CE block reached through a static window in the QMI-reported BAR */
+		.ce_remap = NULL,
+		.bdf_addr_offset = 0,
+
+		.current_cc_support = true,
+
+		.dp_primary_link_only = false,
+		.client = {
+			.max_client_single = 512,
+			.max_client_dbs = 128,
+			.max_client_dbs_sbs = 128,
+		},
+
+		.host_alloc_ml_id = false,
 	},
 };
 
@@ -1297,7 +1400,7 @@
 int ath12k_wifi7_hw_init(struct ath12k_base *ab)
 {
 	const struct ath12k_hw_params *hw_params = NULL;
-	int i;
+	int i, ret;
 
 	for (i = 0; i < ARRAY_SIZE(ath12k_wifi7_hw_params); i++) {
 		hw_params = &ath12k_wifi7_hw_params[i];
@@ -1315,7 +1418,9 @@
 	ab->hw_params = hw_params;
 	ab->ath12k_ops = &ath12k_ops_wifi7;
 
-	ath12k_wifi7_hal_init(ab);
+	ret = ath12k_wifi7_hal_init(ab);
+	if (ret)
+		return ret;
 
 	ath12k_info(ab, "Wi-Fi 7 Hardware name: %s\n", ab->hw_params->name);
 
