+    /// Prepares the source devices for system sleep and replies once each has
+    /// answered or timed out. Spawned so this loop keeps draining their input.
+    async fn suspend_source_devices(&self, sender: mpsc::Sender<()>) {
+        let source_devices = self.source_devices.clone();
+        tokio::task::spawn(async move {
+            // Concurrently, so one source's reply cannot delay the others.
+            let replies = source_devices.values().map(|client| client.suspend());
+            let results = futures::future::join_all(replies).await;
+            for ((source_id, _), result) in source_devices.iter().zip(results) {
+                if let Err(e) = result {
+                    log::warn!("Failed to suspend source device {source_id}: {e:?}");
+                }
+            }
+            if let Err(e) = sender.send(()).await {
+                log::error!("Failed to send suspend source devices response: {e:?}");
+            }
+        });
+    }
+
+    /// Undoes [CompositeDevice::suspend_source_devices] after the system wakes.
+    async fn resume_source_devices(&self, sender: mpsc::Sender<()>) {
+        let source_devices = self.source_devices.clone();
+        tokio::task::spawn(async move {
+            let replies = source_devices.values().map(|client| client.resume());
+            let results = futures::future::join_all(replies).await;
+            for ((source_id, _), result) in source_devices.iter().zip(results) {
+                if let Err(e) = result {
+                    log::warn!("Failed to resume source device {source_id}: {e:?}");
+                }
+            }
+            if let Err(e) = sender.send(()).await {
+                log::error!("Failed to send resume source devices response: {e:?}");
+            }
+        });
+    }
