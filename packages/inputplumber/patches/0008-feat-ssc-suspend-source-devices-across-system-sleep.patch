+    /// Disable the sensors' reports for system sleep. An open sensor keeps
+    /// the ADSP awake and the SoC out of its deep sleep states.
+    pub fn suspend(&mut self) {
+        if !self.suspended {
+            self.suspended = true;
+            self.set_sensors_enabled(false);
+        }
+    }
+
+    /// Enable the sensors' reports again after system sleep.
+    pub fn resume(&mut self) {
+        if self.suspended {
+            self.suspended = false;
+            self.set_sensors_enabled(true);
+        }
+    }
+
+    fn set_sensors_enabled(&mut self, enabled: bool) {
+        let sensors = [&mut self.gyroscope, &mut self.accelerometer];
+        for (sensor, generation) in sensors.into_iter().zip(&self.generation) {
+            let Some(opened) = sensor else { continue };
+            match opened.set_enabled(enabled) {
+                Ok(()) => {}
+                // libssc already dropped the callback; reopening restores it.
+                Err(e) if !enabled => log::warn!("Failed to disable SSC sensor: {e}"),
+                Err(e) => {
+                    log::warn!("Failed to enable SSC sensor, reopening it: {e}");
+                    // libssc keeps callbacks on a failed open, so never free it.
+                    generation.fetch_add(1, Ordering::Relaxed);
+                    std::mem::forget(sensor.take());
+                }
+            }
+        }
+        // Samples queued while a request blocked are stale.
+        while self.rx.try_recv().is_ok() {}
+        if enabled {
+            log::info!("SSC sensors enabled after sleep");
+        } else {
+            log::info!("SSC sensors disabled for sleep");
+        }
+    }
+
     pub fn update_filtered_events(&mut self, events: Vec<Event>) {
         self.filtered_events = events;
     }
