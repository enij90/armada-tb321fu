+#[cfg(test)]
+mod legion_chord_tests {
+    use super::*;
+
+    fn key(code: KeyCode, value: i32) -> InputEvent {
+        InputEvent::new(EventType::KEY.0, code.0, value)
+    }
+
+    fn keys(events: &[InputEvent]) -> Vec<(u16, i32)> {
+        events.iter().map(|e| (e.code(), e.value())).collect()
+    }
+
+    fn expire(filter: &mut LegionChordFilter) {
+        if let Some(at) = filter.release_at.as_mut() {
+            *at = Instant::now() - Duration::from_millis(1);
+        }
+    }
+
+    #[test]
+    fn keeps_legion_held_through_a_chord() {
+        let mut filter = LegionChordFilter::default();
+        let mode = KeyCode::BTN_MODE;
+        let a = KeyCode::BTN_SOUTH;
+        // Legion down, then A: the controller drops Legion in the same report.
+        assert_eq!(keys(&filter.filter(vec![key(mode, 1)])), vec![(mode.0, 1)]);
+        assert_eq!(
+            keys(&filter.filter(vec![key(a, 1), key(mode, 0)])),
+            vec![(a.0, 1)]
+        );
+        // A up; Legion comes back ~150 ms later while still held.
+        assert_eq!(keys(&filter.filter(vec![key(a, 0)])), vec![(a.0, 0)]);
+        assert!(filter.poll().is_none());
+        assert!(filter.filter(vec![key(mode, 1)]).is_empty());
+        assert!(filter.release_at.is_none());
+        // Legion up for good: released after the delay.
+        assert!(filter.filter(vec![key(mode, 0)]).is_empty());
+        assert!(filter.poll().is_none());
+        expire(&mut filter);
+        assert_eq!(filter.poll().map(|e| (e.code(), e.value())), Some((mode.0, 0)));
+        assert!(!filter.held);
+    }
+
+    #[test]
+    fn releases_legion_let_go_during_the_chord() {
+        let mut filter = LegionChordFilter::default();
+        let mode = KeyCode::BTN_MODE;
+        let a = KeyCode::BTN_SOUTH;
+        filter.filter(vec![key(mode, 1)]);
+        filter.filter(vec![key(a, 1), key(mode, 0)]);
+        // Legion was let go first: it never comes back after A.
+        filter.filter(vec![key(a, 0)]);
+        expire(&mut filter);
+        assert_eq!(filter.poll().map(|e| (e.code(), e.value())), Some((mode.0, 0)));
+    }
+
+    #[test]
+    fn a_lone_legion_press_is_delayed_only_on_release() {
+        let mut filter = LegionChordFilter::default();
+        let mode = KeyCode::BTN_MODE;
+        assert_eq!(keys(&filter.filter(vec![key(mode, 1)])), vec![(mode.0, 1)]);
+        assert!(filter.filter(vec![key(mode, 0)]).is_empty());
+        expire(&mut filter);
+        assert_eq!(filter.poll().map(|e| (e.code(), e.value())), Some((mode.0, 0)));
+    }
+
+    #[test]
+    fn a_pushed_dpad_holds_legion() {
+        let mut filter = LegionChordFilter::default();
+        let mode = KeyCode::BTN_MODE;
+        let hat = |value| InputEvent::new(EventType::ABSOLUTE.0, AbsoluteAxisCode::ABS_HAT0Y.0, value);
+        filter.filter(vec![key(mode, 1)]);
+        filter.filter(vec![hat(-1), key(mode, 0)]);
+        assert!(filter.release_at.is_none());
+        filter.filter(vec![hat(0)]);
+        assert!(filter.release_at.is_some());
+        assert!(filter.filter(vec![key(mode, 1)]).is_empty());
+        assert!(filter.release_at.is_none());
+    }
+
+    #[test]
+    fn other_buttons_pass_through() {
+        let mut filter = LegionChordFilter::default();
+        let b = KeyCode::BTN_EAST;
+        assert_eq!(keys(&filter.filter(vec![key(b, 1), key(b, 0)])), vec![(b.0, 1), (b.0, 0)]);
+        assert!(filter.poll().is_none());
+    }
+}
