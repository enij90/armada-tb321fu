+/// The Legion G9 controller (GameSir, 3537:1134) hides its Legion button
+/// (BTN_MODE) while another button is held with it, and reports it again
+/// about 150 ms after that button is released if Legion is still down. Keep
+/// Legion held through those gaps, so a Legion + button chord reaches the
+/// target as one, and release it only once it stayed up for a while.
+const LEGION_G9_ID: (u16, u16) = (0x3537, 0x1134);
+const LEGION_RELEASE_DELAY: Duration = Duration::from_millis(200);
+// Hat axes share the held set with key codes, offset out of the key range.
+const HAT_ID_BASE: u16 = 0x1000;
+
+#[derive(Default)]
+struct LegionChordFilter {
+    held: bool,
+    others: HashSet<u16>,
+    release_at: Option<Instant>,
+}
+
+impl LegionChordFilter {
+    fn event(value: i32) -> InputEvent {
+        InputEvent::new(EventType::KEY.0, KeyCode::BTN_MODE.0, value)
+    }
+
+    fn release_other(&mut self, id: u16) {
+        self.others.remove(&id);
+        // Legion went into hiding with this button: if it does not come
+        // back, it was let go during the chord.
+        if self.held && self.others.is_empty() && self.release_at.is_none() {
+            self.release_at = Some(Instant::now() + LEGION_RELEASE_DELAY);
+        }
+    }
+
+    /// Emit the delayed Legion release once it is due.
+    fn poll(&mut self) -> Option<InputEvent> {
+        let due = self.release_at.is_some_and(|at| Instant::now() >= at);
+        if !due {
+            return None;
+        }
+        self.release_at = None;
+        self.held = false;
+        Some(Self::event(0))
+    }
+
+    fn filter(&mut self, events: Vec<InputEvent>) -> Vec<InputEvent> {
+        let mut out = Vec::with_capacity(events.len());
+        for event in events {
+            // The d-pad is a hat: a pushed hat holds Legion like a button.
+            let hat = event.event_type() == EventType::ABSOLUTE
+                && (event.code() == AbsoluteAxisCode::ABS_HAT0X.0
+                    || event.code() == AbsoluteAxisCode::ABS_HAT0Y.0);
+            if hat {
+                let id = HAT_ID_BASE + event.code();
+                if event.value() != 0 {
+                    self.others.insert(id);
+                } else {
+                    self.release_other(id);
+                }
+                out.push(event);
+                continue;
+            }
+            if event.event_type() != EventType::KEY {
+                out.push(event);
+                continue;
+            }
+            if event.code() == KeyCode::BTN_MODE.0 {
+                match event.value() {
+                    1 => {
+                        self.release_at = None;
+                        if !self.held {
+                            self.held = true;
+                            out.push(event);
+                        }
+                    }
+                    0 if self.held && self.others.is_empty() => {
+                        self.release_at = Some(Instant::now() + LEGION_RELEASE_DELAY);
+                    }
+                    0 => {}
+                    _ => {}
+                }
+                continue;
+            }
+            match event.value() {
+                1 => {
+                    self.others.insert(event.code());
+                }
+                0 => self.release_other(event.code()),
+                _ => {}
+            }
+            out.push(event);
+        }
+        out
+    }
+}
