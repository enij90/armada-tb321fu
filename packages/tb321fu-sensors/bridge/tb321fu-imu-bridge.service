[Unit]
Description=Lenovo TB321FU: accelerometer and gyroscope for InputPlumber
ConditionFirmware=device-tree-compatible(lenovo,tb321fu)
# The SSC answers only once hexagonrpcd has served the sensor registry.
After=tb321fu-sns-init.service
Wants=tb321fu-sns-init.service
Before=inputplumber.service

[Service]
# 200 Hz IMU for aiming (libssc patch), close to the Steam Deck's ~250 Hz
# reports: 400 Hz doubled the CPU time for samples Steam never sees. Other
# libssc users (iio-sensor-proxy, screen rotation) keep the low default rate.
Environment=LIBSSC_MAX_SAMPLE_RATE=200
ExecStart=/usr/libexec/tb321fu-imu-bridge
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
